# El sitio publico no necesita ninguna variable: es HTML estatico.
# Estas son del runtime: /api/health y el backoffice.

# Neon — proyecto dojo-da-luz (aws-eu-central-1)
DATABASE_URL=

# Backoffice (spec 0019). ADMIN_* solo las lee `npm run admin:seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# BO_HOST=bo.aikido-duran.com   # ADR-0016: define el subdominio cuando exista el dominio

# Publicacion del contenido desde el BO (spec 0021)
GITHUB_TOKEN=

# Imagenes en Cloudflare R2 (spec 0030). Sin estas, /admin/medios avisa y no sube nada.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Solo si el bucket se creo con jurisdiccion: `eu` o `fedramp`. Vacio si no la tiene.
# Un bucket con jurisdiccion no se alcanza por el host generico: responde NoSuchBucket.
R2_JURISDICTION=
# Dominio publico del bucket. Es lo que queda escrito en los JSON de contenido:
# cambiarlo obliga a reescribir todas las URLs que apunten ahi.
R2_PUBLIC_URL=

# --- Todavia sin implementar ---
# RESEND_API_KEY=          # spec 0022: recuperacion de contraseña
