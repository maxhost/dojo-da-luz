# El sitio publico no necesita ninguna variable: es HTML estatico.
# Estas son del runtime: /api/health y el backoffice.

# Neon — proyecto dojo-da-luz (aws-eu-central-1)
DATABASE_URL=

# Backoffice (spec 0019). ADMIN_* solo las lee `npm run admin:seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# BO_HOST=bo.aikido-duran.com   # ADR-0016: define el subdominio cuando exista el dominio

# Publicacion del contenido desde el BO (spec 0021)
GITHUB_TOKEN=

# --- Todavia sin implementar ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# RESEND_API_KEY=          # spec 0022: recuperacion de contraseña
