---
import '../styles/global.css'

interface Props {
  titulo: string
  /** El panel lo pasa; el login no, porque todavia no hay sesion. */
  admin?: { email: string } | null
}

const { titulo, admin = null } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{titulo} · Backoffice</title>
  </head>
  <body class="min-h-screen bg-[#f4f0e8] text-[#211f1c] antialiased">
    <header class="border-b border-[#d7cec0] bg-[#fbf8f2]">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
        <a class="font-serif text-xl no-underline" href="/admin">Dojo da Luz · Backoffice</a>
        {admin && (
          <form method="post" action="/admin/salir" class="flex items-center gap-4">
            <span class="text-sm text-[#625c55]">{admin.email}</span>
            <button class="border border-[#d7cec0] bg-white px-3 py-1 text-sm" type="submit">
              Salir
            </button>
          </form>
        )}
      </div>
    </header>

    {admin && (
      <nav class="border-b border-[#d7cec0] bg-[#fbf8f2]" aria-label="Secciones">
        <div class="mx-auto flex max-w-4xl gap-6 px-6 py-2 text-sm">
          <a href="/admin/paginas/home">Home</a>
          <a href="/admin/dojos">Dojos</a>
        </div>
      </nav>
    )}

    <main class="mx-auto max-w-4xl px-6 py-12">
      <slot />
    </main>

    <script>
      /**
       * Contador de caracteres vivo. El valor ya viene resuelto del servidor: esto solo lo
       * mantiene al dia mientras se escribe, asi que sin JavaScript el campo sigue util.
       */
      document
        .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-contador]')
        .forEach((campo) => {
          const salida = document.querySelector<HTMLElement>(`[data-cuenta-de="${campo.id}"]`)
          if (!salida) return

          const recomendado = Number(campo.dataset.recomendado)
          const minimo = Number(campo.dataset.minimo)

          const actualizar = () => {
            const largo = campo.value.length
            let texto = String(largo)
            if (recomendado) {
              texto += ` / ${recomendado} recomendados`
              if (largo > recomendado) texto += ' — se va a cortar en Google'
            }
            if (minimo && largo > 0 && largo < minimo) texto += ` — corto: el mínimo es ${minimo}`
            salida.textContent = texto
          }

          campo.addEventListener('input', actualizar)
          actualizar()
        })
    </script>
  </body>
</html>
