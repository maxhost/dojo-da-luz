---
export const prerender = false

import Admin from '../../../layouts/Admin.astro'
import Aviso from '../../../components/admin/Aviso.astro'
import EditorParcerias from '../../../components/admin/EditorParcerias.astro'
import FormularioHome from '../../../components/admin/FormularioHome.astro'
import { homeSchema } from '../../../lib/content'
import { aplanar, erroresDe, homeDesdeForm, mediaDesdeForm, partnersDesdeForm, resumenDeErrores, type FilaParceiro } from '../../../lib/forms'
import { formulariosParaElegir } from '../../../lib/formularios-edicion'
import { LOCALES, LOCALE_NAME, isLocale, type Locale } from '../../../lib/i18n'
import type { Media } from '../../../lib/media'
import { leerMedia, publicarMedia } from '../../../lib/media-edicion'
import { guardarPartners, leerPartners } from '../../../lib/partners-edicion'
import { leerContenido, publicar, serializar } from '../../../lib/publish'

const admin = Astro.locals.admin!

// Los formularios del selector de la seccion del CTA (spec 0050).
const formularios = await formulariosParaElegir()

const ruta = (locale: Locale) => `content/${locale}/home.json`

type Enviado = { valores: Record<string, string> }

let errores: Partial<Record<Locale, Record<string, string>>> = {}
// Las parcerias son un archivo aparte, sin idioma (ADR-0027): su error y lo que se envio
// viven fuera del mapa por idioma.
let erroresParcerias: Record<string, string> = {}
let parceriasEnviadas: FilaParceiro[] | null = null
let mediosEnviados: Media | null = null
let enviado: Partial<Record<Locale, Enviado>> = {}
let aviso: { tipo: 'ok' | 'error'; texto: string } | null = null
let activo: Locale = isLocale(Astro.url.searchParams.get('idioma') ?? '')
  ? (Astro.url.searchParams.get('idioma') as Locale)
  : 'pt'

const publicado = Astro.url.searchParams.get('publicado')
if (publicado === 'parcerias') {
  aviso = {
    tipo: 'ok',
    texto:
      'Parcerías publicadas. El sitio tarda 1 o 2 minutos en regenerarse: hasta entonces la portada sigue mostrando lo anterior.',
  }
} else if (publicado && isLocale(publicado)) {
  activo = publicado
  aviso = {
    tipo: 'ok',
    texto: `Home en ${LOCALE_NAME[publicado]} publicada. El sitio tarda 1 o 2 minutos en regenerarse: hasta entonces la página pública sigue mostrando lo anterior.`,
  }
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const idioma = String(form.get('idioma') ?? '')

  if (form.get('formulario') === 'parcerias') {
    const guardado = await guardarPartners(form, String(form.get('sha') ?? ''))

    if (guardado.ok) return Astro.redirect('/admin/paginas/home?publicado=parcerias', 303)

    Astro.response.status = guardado.estado
    erroresParcerias = guardado.errores
    // Se repinta lo enviado, no lo publicado: nadie quiere volver a escribir ocho filas
    // porque una traia un error.
    parceriasEnviadas = partnersDesdeForm(form)
    aviso = { tipo: guardado.estado === 200 ? 'ok' : 'error', texto: guardado.aviso }
  } else if (!isLocale(idioma)) {
    Astro.response.status = 400
    aviso = { tipo: 'error', texto: 'Idioma desconocido.' }
  } else {
    activo = idioma
    const datos = homeDesdeForm(form)
    const validado = homeSchema.safeParse(datos)

    // Las imagenes son un archivo aparte que viaja en este mismo formulario (ADR-0029):
    // se resuelven primero, para no dejar publicado el texto y las fotos no.
    const imagenes = await publicarMedia(form, String(form.get('shaMedia') ?? ''))

    if (!validado.success || !imagenes.ok) {
      Astro.response.status = imagenes.ok ? 422 : imagenes.estado
      const mapa = {
        ...(validado.success ? {} : erroresDe(validado.error)),
        ...(imagenes.ok ? {} : imagenes.errores),
      }
      errores = { [idioma]: mapa }
      enviado = { [idioma]: { valores: aplanar(datos) } }
      mediosEnviados = mediaDesdeForm(form) as Media
      aviso = {
        tipo: 'error',
        texto: imagenes.ok ? `No se publicó nada. ${resumenDeErrores(mapa)}` : imagenes.aviso,
      }
    } else {
      try {
      // Se relee para el control de concurrencia: el `sha` del formulario es el de cuando
      // se abrio la pagina, no necesariamente el que tiene `main` ahora.
      const actual = await leerContenido(ruta(idioma))
      const contenido = serializar(validado.data)

      if (actual.sha !== String(form.get('sha') ?? '')) {
        Astro.response.status = 409
        aviso = {
          tipo: 'error',
          texto: 'Alguien editó este archivo mientras tanto. No se pisó nada: recargá la página y volvé a aplicar tu cambio.',
        }
      } else if (actual.contenido === contenido) {
        if (imagenes.cambio) return Astro.redirect(`/admin/paginas/home?publicado=${idioma}`, 303)
        aviso = { tipo: 'ok', texto: 'No había cambios: no se publicó nada.' }
      } else {
        const resultado = await publicar({
          ruta: ruta(idioma),
          contenido,
          mensaje: `contenido: Home en ${LOCALE_NAME[idioma]} desde el backoffice`,
          sha: actual.sha,
        })

        if (resultado.ok) return Astro.redirect(`/admin/paginas/home?publicado=${idioma}`, 303)

        Astro.response.status = resultado.motivo === 'conflicto' ? 409 : 502
        aviso = {
          tipo: 'error',
          texto:
            resultado.motivo === 'conflicto'
              ? 'Alguien editó este archivo mientras tanto. No se pisó nada.'
              : `No se pudo publicar: ${resultado.detalle}`,
        }
      }
      } catch (error) {
        Astro.response.status = 503
        const detalle = error instanceof Error ? error.message : String(error)
        aviso = { tipo: 'error', texto: `No se pudo publicar: ${detalle}` }
      }
    }
  }
}

type Archivo = {
  locale: Locale
  sha: string
  valores: Record<string, string>
  errores: Record<string, string>
}

// Leer el contenido es hablar con un servicio remoto. Que falte el token o se caiga
// GitHub no es un 500: es un aviso que dice que el editor no puede abrir.
let archivos: Archivo[] = []
let parcerias: { partners: FilaParceiro[]; sha: string } | null = null
let medios: { media: Media; sha: string } | null = null
let sinRepositorio: string | null = null

try {
  const leidas = await leerPartners()
  parcerias = { partners: parceriasEnviadas ?? leidas.partners, sha: leidas.sha }
  const leidos = await leerMedia()
  medios = { media: mediosEnviados ?? leidos.media, sha: leidos.sha }
  archivos = await Promise.all(
  LOCALES.map(async (locale) => {
    const archivo = await leerContenido(ruta(locale))
    const propio = enviado[locale]
    return {
      locale,
      sha: archivo.sha,
      valores: propio?.valores ?? aplanar(JSON.parse(archivo.contenido)),
      errores: errores[locale] ?? {},
    }
  }),
  )
} catch (error) {
  Astro.response.status = 503
  sinRepositorio = error instanceof Error ? error.message : String(error)
}

/**
 * Pestañas en CSS: los cuatro formularios estan en la pagina desde el principio, asi que
 * cambiar de idioma no navega y no pierde lo escrito sin guardar. Las clases van
 * literales porque Tailwind las busca como texto en el archivo.
 */
const TABS = [
  { locale: 'pt' },
  { locale: 'es' },
  { locale: 'fr' },
  { locale: 'en' },
] as const
---

<Admin titulo="Home" admin={admin}>
  <header class="max-w-3xl">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#0077c7]">Contenido del sitio</p>
    <h1 class="mt-2 font-serif text-3xl leading-tight sm:text-4xl">Página Home</h1>
    <p class="mt-3 text-sm leading-6 text-[#625c55] sm:text-base">
      Editá la portada por secciones. Cada idioma se guarda por separado; podés cambiar de
      pestaña sin perder lo que todavía no publicaste.
    </p>
  </header>

  {aviso && <Aviso tipo={aviso.tipo}>{aviso.texto}</Aviso>}
  {sinRepositorio && <Aviso tipo="error">No se puede abrir el editor: {sinRepositorio}</Aviso>}

  {sinRepositorio === null && (
  <div class="mt-7" data-pestanas-idioma>
    <div class="sticky top-16 z-20 grid grid-cols-4 gap-1 rounded-lg border border-[#d7cec0] bg-[#eee9e0]/95 p-1 shadow-sm backdrop-blur lg:top-0">
      {TABS.map((tab) => (
        <div>
          <input class="peer sr-only" type="radio" name="idioma-activo" id={`tab-${tab.locale}`} value={tab.locale} checked={activo === tab.locale} />
          <label
            class:list={[
              'flex min-h-11 cursor-pointer items-center justify-center rounded-md px-1 text-center text-xs font-semibold transition-colors sm:px-4 sm:text-sm',
              activo === tab.locale ? 'bg-[#0099ff] text-white' : 'text-[#625c55] hover:bg-white/70',
            ]}
            for={`tab-${tab.locale}`}
            data-etiqueta-idioma={tab.locale}
          >
            <span class="sm:hidden">{tab.locale.toUpperCase()}</span>
            <span class="hidden sm:inline">{LOCALE_NAME[tab.locale]}</span>
          </label>
        </div>
      ))}
    </div>

    {TABS.map((tab) => {
      const archivo = archivos.find((a) => a.locale === tab.locale)!
      return (
        <section class="pt-5" hidden={activo !== tab.locale} data-panel-idioma={tab.locale} aria-label={`Contenido en ${LOCALE_NAME[tab.locale]}`}>
          <FormularioHome
            medios={medios!.media}
            shaMedia={medios!.sha}
            locale={archivo.locale}
            valores={archivo.valores}
            errores={archivo.errores}
            sha={archivo.sha}
            formularios={formularios}
          />
        </section>
      )
    })}
  </div>
  )}

  {sinRepositorio === null && parcerias && (
  <section class="mt-12 rounded-xl border border-[#d7cec0] bg-white p-4 sm:p-6">
    <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#0077c7]">Contenido compartido</p>
    <h2 class="mt-2 font-serif text-2xl">Logos de parcerías</h2>
    <EditorParcerias
      partners={parcerias.partners}
      errores={erroresParcerias}
      sha={parcerias.sha}
    />
  </section>
  )}

  <script>
    document.querySelectorAll<HTMLElement>('[data-pestanas-idioma]').forEach((editor) => {
      editor.querySelectorAll<HTMLInputElement>('input[name="idioma-activo"]').forEach((control) => {
        control.addEventListener('change', () => {
          if (!control.checked) return
          editor.querySelectorAll<HTMLElement>('[data-panel-idioma]').forEach((panel) => {
            panel.hidden = panel.dataset.panelIdioma !== control.value
          })
          editor.querySelectorAll<HTMLElement>('[data-etiqueta-idioma]').forEach((etiqueta) => {
            const seleccionada = etiqueta.dataset.etiquetaIdioma === control.value
            etiqueta.classList.toggle('bg-[#0099ff]', seleccionada)
            etiqueta.classList.toggle('text-white', seleccionada)
            etiqueta.classList.toggle('text-[#625c55]', !seleccionada)
            etiqueta.classList.toggle('hover:bg-white/70', !seleccionada)
          })
        })
      })
    })
  </script>
</Admin>
