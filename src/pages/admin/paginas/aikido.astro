---
export const prerender = false

import Admin from '../../../layouts/Admin.astro'
import Aviso from '../../../components/admin/Aviso.astro'
import EditorPestanas from '../../../components/admin/EditorPestanas.astro'
import FormularioAikido from '../../../components/admin/FormularioAikido.astro'
import { paginaAikido } from '../../../lib/aikido-edicion'
import { pantallaEditor } from '../../../lib/editor-pantalla'

/** Editor de `/aikido` (spec 0037). */

const admin = Astro.locals.admin!
const pantalla = await pantallaEditor(paginaAikido, Astro.request, Astro.url)

if (pantalla.redirigir) return Astro.redirect(pantalla.redirigir, 303)
if (pantalla.estado) Astro.response.status = pantalla.estado
---

<Admin titulo="Aikido" admin={admin}>
  <header class="max-w-3xl">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#0077c7]">Contenido del sitio</p>
    <h1 class="mt-2 font-serif text-3xl leading-tight sm:text-4xl">Página Aikido</h1>
    <p class="mt-3 text-sm leading-6 text-[#625c55] sm:text-base">Editá la presentación del Aikido, sus secciones explicativas, el bloque de O-Sensei y el cierre. La estructura y las fotos compartidas se administran en portugués.</p>
  </header>

  {pantalla.aviso && <Aviso tipo={pantalla.aviso.tipo}>{pantalla.aviso.texto}</Aviso>}
  {pantalla.sinRepositorio && (
    <Aviso tipo="error">No se puede abrir el editor: {pantalla.sinRepositorio}</Aviso>
  )}

  {pantalla.sinRepositorio === null && (
    <EditorPestanas
      formulario={FormularioAikido}
      archivos={pantalla.archivos}
      errores={pantalla.errores}
      shas={pantalla.shas}
      activo={pantalla.activo}
    />
  )}
</Admin>
