---
export const prerender = false

import Admin from '../../../layouts/Admin.astro'
import Aviso from '../../../components/admin/Aviso.astro'
import EditorPestanas from '../../../components/admin/EditorPestanas.astro'
import FormularioOutrasArtes from '../../../components/admin/FormularioOutrasArtes.astro'
import { paginaOutrasArtes } from '../../../lib/outras-artes-edicion'
import { pantallaEditor } from '../../../lib/editor-pantalla'
import { formulariosParaElegir } from '../../../lib/formularios-edicion'

/** Editor de `/outras-artes` (spec 0040). */

const admin = Astro.locals.admin!
const pantalla = await pantallaEditor(paginaOutrasArtes, Astro.request, Astro.url)
const formularios = await formulariosParaElegir()

if (pantalla.redirigir) return Astro.redirect(pantalla.redirigir, 303)
if (pantalla.estado) Astro.response.status = pantalla.estado
---

<Admin titulo="Outras artes" admin={admin}>
  <header class="max-w-3xl">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#0077c7]">Contenido del sitio</p>
    <h1 class="mt-2 font-serif text-3xl leading-tight sm:text-4xl">Página Outras artes</h1>
    <p class="mt-3 text-sm leading-6 text-[#625c55] sm:text-base">Editá los bloques de Shiatsu, Iaido y Tai Chi Chuan, además de la galería compartida. Las fotos y los medios se administran desde portugués.</p>
  </header>

  {pantalla.aviso && <Aviso tipo={pantalla.aviso.tipo}>{pantalla.aviso.texto}</Aviso>}
  {pantalla.sinRepositorio && (
    <Aviso tipo="error">No se puede abrir el editor: {pantalla.sinRepositorio}</Aviso>
  )}

  {pantalla.sinRepositorio === null && (
    <EditorPestanas
      formulario={FormularioOutrasArtes}
      archivos={pantalla.archivos}
      errores={pantalla.errores}
      shas={pantalla.shas}
      activo={pantalla.activo}
      extra={{ formularios }}
    />
  )}
</Admin>
