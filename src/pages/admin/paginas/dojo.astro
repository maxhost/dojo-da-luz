---
export const prerender = false

import Admin from '../../../layouts/Admin.astro'
import Aviso from '../../../components/admin/Aviso.astro'
import EditorPestanas from '../../../components/admin/EditorPestanas.astro'
import FormularioPaginaDojo from '../../../components/admin/FormularioPaginaDojo.astro'
import { paginaDojo } from '../../../lib/pagina-dojo-edicion'
import { pantallaEditor } from '../../../lib/editor-pantalla'

/** Editor de `/dojo` (spec 0038). */

const admin = Astro.locals.admin!
const pantalla = await pantallaEditor(paginaDojo, Astro.request, Astro.url)

if (pantalla.redirigir) return Astro.redirect(pantalla.redirigir, 303)
if (pantalla.estado) Astro.response.status = pantalla.estado
---

<Admin titulo="O dojo" admin={admin}>
  <header class="max-w-3xl">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#0077c7]">Contenido del sitio</p>
    <h1 class="mt-2 font-serif text-3xl leading-tight sm:text-4xl">Página O dojo</h1>
    <p class="mt-3 text-sm leading-6 text-[#625c55] sm:text-base">Editá la portada, el espacio de práctica, el profesor principal, el equipo y la transmisión. Los profesores y las fotos compartidas se administran en portugués.</p>
  </header>

  {pantalla.aviso && <Aviso tipo={pantalla.aviso.tipo}>{pantalla.aviso.texto}</Aviso>}
  {pantalla.sinRepositorio && (
    <Aviso tipo="error">No se puede abrir el editor: {pantalla.sinRepositorio}</Aviso>
  )}

  {pantalla.sinRepositorio === null && (
    <EditorPestanas
      formulario={FormularioPaginaDojo}
      archivos={pantalla.archivos}
      errores={pantalla.errores}
      shas={pantalla.shas}
      activo={pantalla.activo}
    />
  )}
</Admin>
