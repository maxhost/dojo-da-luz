---
export const prerender = false

import Admin from '../../layouts/Admin.astro'
import { backend } from '../../lib/publish'

// El middleware ya garantizo la sesion: aca nunca es null.
const admin = Astro.locals.admin!
const destino = backend()
---

<Admin titulo="Panel" admin={admin}>
  <h1 class="font-serif text-3xl">Panel</h1>
  <p class="mt-4 text-[#625c55]">
    Sesión iniciada como <strong>{admin.email}</strong>.
  </p>

  <ul class="mt-8">
    <li class="border-t border-[#d7cec0] py-4">
      <a class="font-serif text-xl" href="/admin/paginas/home">Home</a>
      <p class="mt-1 text-sm text-[#625c55]">
        Textos y SEO de la portada en portugués, español, francés e inglés.
      </p>
    </li>
    <li class="border-t border-[#d7cec0] py-4">
      <a class="font-serif text-xl" href="/admin/paginas/aulas">Aulas</a>
      <p class="mt-1 text-sm text-[#625c55]">
        Horarios, cuotas, crianças y preguntas frecuentes. Las listas se arman en portugués
        y se traducen en las otras pestañas.
      </p>
    </li>
    <li class="border-t border-[#d7cec0] py-4">
      <a class="font-serif text-xl" href="/admin/paginas/adultos">Adultos</a>
      <p class="mt-1 text-sm text-[#625c55]">
        La página de Aikido para adultos: textos, la galería de fotos y vídeos, y las
        preguntas frecuentes.
      </p>
    </li>
    <li class="border-t border-[#d7cec0] py-4">
      <a class="font-serif text-xl" href="/admin/paginas/criancas">Crianças</a>
      <p class="mt-1 text-sm text-[#625c55]">
        La página de Aikido para crianças e adolescentes. Misma forma que la de adultos, y
        se publica por separado.
      </p>
    </li>
    <li class="border-t border-[#d7cec0] py-4">
      <a class="font-serif text-xl" href="/admin/paginas/aikido">Aikido</a>
      <p class="mt-1 text-sm text-[#625c55]">
        Qué es el Aikido: las secciones numeradas, el bloque de O-Sensei y el cierre.
      </p>
    </li>
    <li class="border-t border-[#d7cec0] py-4">
      <a class="font-serif text-xl" href="/admin/paginas/dojo">O dojo</a>
      <p class="mt-1 text-sm text-[#625c55]">
        El dojo y su equipo: el bloque del profesor principal, el listado de profesores y
        las tres cajas de la transmisión.
      </p>
    </li>
    <li class="border-t border-[#d7cec0] py-4">
      <a class="font-serif text-xl" href="/admin/paginas/eventos">Eventos</a>
      <p class="mt-1 text-sm text-[#625c55]">
        La agenda: se crean y se quitan eventos sin límite. Si no queda ninguno, la página
        lo dice.
      </p>
    </li>
    <li class="border-t border-[#d7cec0] py-4">
      <a class="font-serif text-xl" href="/admin/paginas/outras-artes">Outras artes</a>
      <p class="mt-1 text-sm text-[#625c55]">
        Shiatsu, Iaido y Tai Chi Chuan, cada una con su foto y sus textos, más la galería
        de fotos y vídeos del final.
      </p>
    </li>
    <li class="border-t border-[#d7cec0] py-4">
      <a class="font-serif text-xl" href="/admin/medios">Imágenes</a>
      <p class="mt-1 text-sm text-[#625c55]">
        Subir fotos al almacenamiento del sitio y copiar su dirección.
      </p>
    </li>
    <li class="border-t border-[#d7cec0] py-4">
      <a class="font-serif text-xl" href="/admin/dojos">Dojos</a>
      <p class="mt-1 text-sm text-[#625c55]">
        Sedes, direcciones y horarios. Se cargan una vez y salen traducidos en los cuatro
        idiomas.
      </p>
    </li>
  </ul>

  <p class="mt-8 border border-[#d7cec0] bg-[#fbf8f2] px-4 py-3 text-sm text-[#625c55]">
    {destino === 'github' ? (
      <>
        Cada guardado es un commit en <code>main</code>: el sitio se reconstruye solo y
        tarda 1 o 2 minutos en mostrar el cambio.
      </>
    ) : (
      <>
        <strong>Modo desarrollo.</strong> Sin <code>GITHUB_TOKEN</code> los cambios se
        escriben en los archivos locales, no en GitHub.
      </>
    )}
  </p>
</Admin>
