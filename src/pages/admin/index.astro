---
export const prerender = false

import Admin from '../../layouts/Admin.astro'
import { backend } from '../../lib/publish'

const admin = Astro.locals.admin!
const destino = backend()
---

<Admin titulo="Panel" admin={admin}>
  <header>
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#0077c7]">Panel principal</p>
    <h1 class="mt-2 font-serif text-3xl leading-tight sm:text-4xl">Bienvenido al administrador</h1>
    <p class="mt-3 max-w-2xl text-sm leading-6 text-[#625c55] sm:text-base">
      Elegí una sección del menú para actualizar el contenido del sitio. En el teléfono,
      abrí <strong>Menú</strong> en la parte superior para moverte entre secciones.
    </p>
  </header>

  <section class="mt-8 grid gap-4 sm:grid-cols-2" aria-label="Cómo está organizado el panel">
    <article class="rounded-lg border border-[#d7cec0] bg-[#fbf8f2] p-5 sm:p-6">
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#0077c7]">Contenido</p>
      <h2 class="mt-2 font-serif text-xl">Páginas del sitio</h2>
      <p class="mt-2 text-sm leading-6 text-[#625c55]">
        Editá los textos y contenidos de Home, Aulas, Aikido, Eventos y las demás páginas.
      </p>
    </article>
    <article class="rounded-lg border border-[#d7cec0] bg-[#fbf8f2] p-5 sm:p-6">
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#0077c7]">Gestión</p>
      <h2 class="mt-2 font-serif text-xl">Dojos, imágenes y ajustes</h2>
      <p class="mt-2 text-sm leading-6 text-[#625c55]">
        Administrá las sedes, los archivos compartidos y la identidad general del sitio.
      </p>
    </article>
  </section>

  <aside class="mt-6 rounded-lg border border-[#d7cec0] bg-white px-5 py-4 text-sm leading-6 text-[#625c55]">
    {destino === 'github' ? (
      <p>
        <strong class="text-[#211f1c]">Publicación automática.</strong> Cada guardado se
        publica y puede tardar 1 o 2 minutos en verse en el sitio.
      </p>
    ) : (
      <p>
        <strong class="text-[#211f1c]">Modo desarrollo.</strong> Los cambios se escriben
        en los archivos locales y no se publican en GitHub.
      </p>
    )}
  </aside>
</Admin>
