---
export const prerender = false

import Admin from '../../layouts/Admin.astro'
import { verifyPassword } from '../../lib/auth'
import {
  MAX_INTENTOS,
  buscarAdminPorEmail,
  crearSesion,
  intentosFallidos,
  registrarIntento,
} from '../../lib/admin'

if (Astro.locals.admin) return Astro.redirect('/admin', 302)

/**
 * Hash de descarte: cuando el email no existe igual se corre scrypt, para que el tiempo
 * de respuesta no diga si la cuenta existe.
 */
const HASH_SEÑUELO =
  'scrypt$32768$8$1$AAAAAAAAAAAAAAAAAAAAAA==$' +
  'ZGVjb3lkZWNveWRlY295ZGVjb3lkZWNveWRlY295ZGVjb3lkZWNveWRlY295ZGVjb3lkZWNveWRlY295ZGU='

let error: string | null = null
let email = ''

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  email = String(form.get('email') ?? '').trim().toLowerCase()
  const password = String(form.get('password') ?? '')

  if (await intentosFallidos(email) >= MAX_INTENTOS) {
    Astro.response.status = 429
    error = 'Demasiados intentos fallidos. Esperá 15 minutos antes de volver a probar.'
  } else {
    const admin = await buscarAdminPorEmail(email)
    const ok = await verifyPassword(password, admin?.password_hash ?? HASH_SEÑUELO)

    await registrarIntento(email, ok && admin !== null)

    if (ok && admin) {
      await crearSesion(admin.id, Astro.cookies)
      return Astro.redirect('/admin', 302)
    }

    Astro.response.status = 401
    // Generico a proposito: nunca decir cual de los dos campos esta mal.
    error = 'Email o contraseña incorrectos.'
  }
}
---

<Admin titulo="Entrar">
  <div class="mb-7 text-center">
    <a class="inline-block no-underline" href="/" aria-label="Ir al sitio de Dojo da Luz">
      <span class="block font-serif text-2xl">Dojo da Luz</span>
      <span class="mt-1 block text-[0.65rem] font-bold uppercase tracking-[0.2em] text-[#625c55]">Administración</span>
    </a>
  </div>

  <section class="rounded-xl border border-[#d7cec0] bg-[#fbf8f2] p-5 shadow-[0_18px_50px_rgba(33,31,28,0.08)] sm:p-8">
    <header>
      <h1 class="font-serif text-3xl">Iniciar sesión</h1>
      <p class="mt-2 text-sm leading-6 text-[#625c55]">Ingresá tus datos para administrar el contenido del sitio.</p>
    </header>

    {error && (
      <p class="mt-5 rounded-md border border-[#0099ff]/40 bg-[#e6f6ff] px-4 py-3 text-sm text-[#075c91]" role="alert">
        {error}
      </p>
    )}

    <form class="mt-6" method="post">
      <label class="block text-sm font-semibold" for="email">Email</label>
      <input
        class="mt-2 min-h-12 w-full rounded-md border border-[#c9c0b3] bg-white px-3.5 text-base outline-none transition focus:border-[#0099ff] focus:ring-2 focus:ring-[#0099ff]/20"
        id="email"
        name="email"
        type="email"
        inputmode="email"
        value={email}
        required
        autocomplete="username"
        autofocus
      />

      <label class="mt-5 block text-sm font-semibold" for="password">Contraseña</label>
      <input
        class="mt-2 min-h-12 w-full rounded-md border border-[#c9c0b3] bg-white px-3.5 text-base outline-none transition focus:border-[#0099ff] focus:ring-2 focus:ring-[#0099ff]/20"
        id="password"
        name="password"
        type="password"
        required
        autocomplete="current-password"
      />

      <button class="mt-6 min-h-12 w-full rounded-md bg-[#0099ff] px-4 font-semibold text-white transition hover:bg-[#0077c7] focus:outline-none focus:ring-2 focus:ring-[#0099ff] focus:ring-offset-2" type="submit">
        Entrar al panel
      </button>
    </form>
  </section>

  <p class="mt-5 text-center text-xs leading-5 text-[#746d64]">
    Si perdiste la contraseña, pedí al responsable técnico que restablezca tu acceso.
  </p>
</Admin>
