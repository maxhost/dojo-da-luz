---
import Base from '../layouts/Base.astro'; import FormModal from './FormModal.astro'; import { getContent } from '../lib/content'; import { pathFor, siteNav, type Locale } from '../lib/i18n'
interface Props { locale:Locale } const {locale}=Astro.props; const c=getContent('otherArts',locale)
const ui={pt:['Aikido · Lisboa','Menu','Saltar para o conteúdo','Associação sem fins lucrativos'],es:['Aikido · Lisboa','Menú','Saltar al contenido','Asociación sin fines de lucro'],fr:['Aïkido · Lisbonne','Menu','Aller au contenu','Association à but non lucratif'],en:['Aikido · Lisbon','Menu','Skip to content','Non-profit association']}[locale]
---
<Base page="otherArts" locale={locale} title={c.seo.title} description={c.seo.description} skipLink={ui[2]} nav={siteNav(locale)} menuLabel={ui[1]} caption={ui[0]}>
<section class="section-pad bg-[#27231f] text-center text-white"><div class="site-shell"><p class="section-kicker text-[#efb49b]">{c.eyebrow}</p><h1 class="mx-auto mt-4 max-w-4xl font-serif text-5xl md:text-7xl">{c.title}</h1><p class="mx-auto mt-6 max-w-2xl text-xl leading-9 text-white/75">{c.lead}</p></div></section>
<div class="bg-[#f6f1e8]">{c.activities.map((activity,index)=><section id={activity.id} class="section-pad border-b border-[#d7cec0]"><div class={`site-shell grid gap-12 md:grid-cols-2 md:items-start md:gap-20 ${index%2===1?'md:[&>figure]:order-2':''}`}><figure class="m-0"><img src={activity.photo} alt={activity.photoAlt} class="max-h-[38rem] w-full object-cover" loading="lazy" /></figure><div><p class="section-kicker">0{index+1} · {activity.subtitle}</p><h2 class="mt-4 font-serif text-5xl">{activity.name}</h2>{activity.paragraphs.map(p=><p class="mt-5 text-lg leading-8 text-[#4c4741]">{p}</p>)}{activity.benefits.length>0&&<ul class="mt-7 grid gap-2 border-y border-[#d7cec0] py-5 text-[#625c55] sm:grid-cols-2">{activity.benefits.map(item=><li>{item}</li>)}</ul>}{activity.schedule.length>0&&<div class="mt-7 border-l-2 border-[#9b3025] pl-5">{activity.schedule.map(item=><p class="mt-2 first:mt-0">{item}</p>)}{activity.teacher&&<p class="mt-4 font-bold text-[#9b3025]">{activity.teacher}</p>}</div>}<div class="mt-8">{activity.formUrl?<FormModal id={`form-${activity.id}`} title={`${activity.name} · ${activity.trialLabel}`} trigger={activity.trialLabel} url={activity.formUrl} directLabel={activity.directLabel} closeLabel={activity.closeLabel}/>:<a class="button button-primary" href={pathFor('contact',locale)}>{activity.trialLabel}</a>}</div></div></div></section>)}</div>
<p slot="footer-note" class="text-sm text-white/65">Benfica · Lumiar · Encarnação<br />{ui[3]}</p></Base>
