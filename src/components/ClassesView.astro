---
import Base from '../layouts/Base.astro'
import { getContent } from '../lib/content'
import { pathFor, siteNav, type Locale } from '../lib/i18n'

interface Props { locale: Locale }

const { locale } = Astro.props
const c = getContent('classes', locale)
const nav = siteNav(locale)
const audienceLabels = {
  pt: { adults: 'Aulas para adultos', children: 'Aulas para crianças' },
  es: { adults: 'Clases para adultos', children: 'Clases para niños' },
  fr: { adults: 'Cours pour adultes', children: 'Cours pour enfants' },
  en: { adults: 'Adult classes', children: "Children's classes" },
}[locale]
const pricingId: Record<Locale, string> = { pt: 'quotas', es: 'cuotas', fr: 'tarifs', en: 'fees' }

const HERO_PHOTO =
  'https://static.wixstatic.com/media/ae7240_de66207c487b4e8086d18ed67c88ea93~mv2.jpg/v1/crop/x_218,y_0,w_1165,h_900/fill/w_1600,h_1067,al_c,q_85/IMG_3502_JPG.jpg'
---

<Base
  page="classes"
  locale={locale}
  title={c.seo.title}
  description={c.seo.description}
  skipLink={c.chrome.skipLink}
  nav={nav}
  menuLabel={c.chrome.menuLabel}
  caption={c.chrome.caption}
>
  <section class="relative isolate flex min-h-[31rem] items-end overflow-hidden bg-[#292522] text-white md:min-h-[36rem]">
    <img src={HERO_PHOTO} alt="" class="absolute inset-0 -z-20 h-full w-full object-cover" fetchpriority="high" />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/65"></div>
    <div class="site-shell py-16 text-center md:py-20">
      <p class="text-xs font-bold uppercase tracking-[.2em] text-[#efb49b]">{c.hero.eyebrow}</p>
      <h1 class="mx-auto mt-5 max-w-4xl font-serif text-5xl font-normal leading-[1.04] md:text-7xl">{c.hero.title}</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-white/85">{c.hero.lead}</p>
      <p class="mt-5 text-sm font-bold uppercase tracking-[.14em] text-white/65">{c.hero.season}</p>
      <a class="button button-primary mt-8" href="#horarios">{c.hero.ctaLabel}</a>
    </div>
  </section>

  <section id="horarios" class="section-pad bg-[#f6f1e8]">
    <div class="site-shell">
      <div class="max-w-3xl">
        <p class="section-kicker">{c.schedule.label}</p>
        <h2 class="section-title mt-4">{c.schedule.title}</h2>
        <p class="mt-5 text-lg leading-8 text-[#625c55]">{c.schedule.intro}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="button button-primary" href={pathFor('adults', locale)}>{audienceLabels.adults}</a>
          <a class="button border border-[#9b3025] text-[#9b3025]" href={pathFor('children', locale)}>{audienceLabels.children}</a>
        </div>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {c.schedule.venues.map((venue, index) => (
          <article class="border border-[#d7cec0] bg-white p-7 md:p-8">
            <p class="text-xs font-bold uppercase tracking-[.18em] text-[#9b3025]">0{index + 1} · {venue.area}</p>
            <h3 class="mt-4 font-serif text-2xl font-normal leading-tight">{venue.name}</h3>
            <dl class="mt-7 divide-y divide-[#e4ddd2] border-t border-[#d7cec0]">
              {venue.classes.map((item) => (
                <div class="py-5">
                  <dt class="text-xs font-bold uppercase tracking-[.12em] text-[#756e66]">{item.audience}</dt>
                  <dd class="m-0 mt-2 text-base leading-7 text-[#211f1c]">{item.time}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id={pricingId[locale]} class="section-pad bg-white">
    <div class="site-shell">
      <div class="grid gap-10 md:grid-cols-[.8fr_1.2fr] md:gap-20">
        <div>
          <p class="section-kicker">{c.pricing.label}</p>
          <h2 class="section-title mt-4">{c.pricing.title}</h2>
          <p class="mt-5 text-lg leading-8 text-[#625c55]">{c.pricing.intro}</p>
        </div>
        <div class="grid grid-cols-2 border-l border-t border-[#d7cec0]">
          {c.pricing.items.map((item) => (
            <article class="border-b border-r border-[#d7cec0] p-5 md:p-6">
              <h3 class="text-xs font-bold uppercase tracking-[.12em] text-[#756e66]">{item.name}</h3>
              <p class="mt-3 font-serif text-2xl text-[#9b3025] md:text-3xl">{item.price}</p>
              <p class="mt-2 text-sm leading-6 text-[#625c55]">{item.detail}</p>
            </article>
          ))}
        </div>
      </div>
      <ul class="mt-10 grid gap-3 border-t border-[#d7cec0] pt-7 text-sm leading-6 text-[#625c55] md:grid-cols-2 md:gap-x-12">
        {c.pricing.notes.map((note) => <li>{note}</li>)}
      </ul>
    </div>
  </section>

  <section id="criancas" class="section-pad bg-[#27231f] text-white">
    <div class="site-shell grid gap-12 md:grid-cols-[1fr_1.1fr] md:gap-20">
      <div>
        <p class="section-kicker text-[#efb49b]">{c.children.label}</p>
        <h2 class="section-title mt-4 text-white">{c.children.title}</h2>
        {c.children.paragraphs.map((paragraph) => <p class="mt-5 text-lg leading-8 text-white/75">{paragraph}</p>)}
      </div>
      <dl class="divide-y divide-white/20 border-y border-white/20">
        {c.children.facts.map((fact) => (
          <div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]">
            <dt class="text-xs font-bold uppercase tracking-[.14em] text-[#efb49b]">{fact.label}</dt>
            <dd class="m-0 text-base leading-7 text-white/90">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="aula-experimental" class="section-pad bg-[#9b3025] text-center text-white">
    <div class="site-shell">
      <p class="section-kicker text-[#f4c9b6]">{c.trial.label}</p>
      <h2 class="mx-auto mt-4 max-w-3xl font-serif text-4xl font-normal leading-tight md:text-6xl">{c.trial.title}</h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-white/85">{c.trial.text}</p>
      <p class="mx-auto mt-3 max-w-2xl text-sm font-bold leading-6 text-white">{c.trial.note}</p>
      <a href="mailto:EMAIL-PENDENTE" class="button mt-9 bg-white text-[#752219]">{c.trial.ctaLabel}</a>
    </div>
  </section>

  <p slot="footer-note" class="text-sm leading-6 text-white/65">
    {c.chrome.footerNote.areas}<br />{c.chrome.footerNote.orgType}
  </p>
</Base>
