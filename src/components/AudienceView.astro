---
import Base from '../layouts/Base.astro'
import FormModal from './FormModal.astro'
import GaleriaMedios from './GaleriaMedios.astro'
import QaSection from './QaSection.astro'
import { getContent } from '../lib/content'
import { faqJsonLd } from '../lib/site'
import { siteNav, type Locale, type PageKey } from '../lib/i18n'

interface Props { locale: Locale; page: 'adults' | 'children' }
const { locale, page } = Astro.props
const c = getContent(page as PageKey, locale) as ReturnType<typeof getContent<'adults'>>
const formId = `form-${page}`

// Los cinco textos del borde de la pagina salian de un objeto escrito aca adentro, asi que
// no habia nada que editar aunque hubiera editor (spec 0036). Ahora viven en el contenido,
// con la misma forma que en `/aulas`.
const chrome = c.chrome
---
<Base page={page} locale={locale} title={c.seo.title} description={c.seo.description} skipLink={chrome.skipLink} nav={siteNav(locale)} menuLabel={chrome.menuLabel} caption={chrome.caption}>
  <section class="section-pad bg-[#f6f1e8]"><div class="site-shell grid gap-12 md:grid-cols-[1.05fr_.95fr] md:items-center md:gap-20">
    <div><p class="section-kicker">{c.eyebrow}</p><h1 class="section-title mt-4 text-5xl md:text-7xl">{c.title}</h1><p class="mt-6 text-xl leading-9 text-[#625c55]">{c.lead}</p><button class="button mt-8 bg-[#0099ff] text-white" type="button" data-modal-open={formId}>{c.trialLabel}</button></div>
    <img src={c.photo} alt={c.photoAlt} class="max-h-[38rem] w-full object-cover" fetchpriority="high" />
  </div></section>
  <section class="section-pad bg-white"><div class="site-shell grid gap-12 md:grid-cols-2 md:gap-20">
    <div>{c.paragraphs.map((p) => <p class="mt-5 text-lg leading-8 text-[#4c4741] first:mt-0">{p}</p>)}</div>
    <div><h2 class="font-serif text-3xl">{c.goalsTitle}</h2><ul class="mt-6 divide-y divide-[#d7cec0] border-y border-[#d7cec0]">{c.goals.map((goal) => <li class="py-4">{goal}</li>)}</ul></div>
  </div></section>
  <section class="section-pad bg-[#27231f] text-white"><div class="site-shell"><dl class="grid gap-px bg-white/20 md:grid-cols-2">{c.facts.map((fact) => <div class="bg-[#27231f] p-6"><dt class="text-xs font-bold uppercase tracking-[.14em] text-[#b3e5ff]">{fact.label}</dt><dd class="m-0 mt-3 text-lg leading-7">{fact.value}</dd></div>)}</dl></div></section>
  <section class="section-pad overflow-hidden bg-[#f6f1e8]">
    <div class="site-shell">
      <div class="max-w-2xl">
        <p class="section-kicker">{c.gallery.label}</p>
        <h2 class="section-title mt-4 text-4xl md:text-6xl">{c.gallery.title}</h2>
        <p class="mt-5 text-lg leading-8 text-[#625c55]">{c.gallery.intro}</p>
      </div>
      <GaleriaMedios gallery={c.gallery} />
    </div>
  </section>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqJsonLd(c.qa.items))} />

  <QaSection label={c.qa.label} title={c.qa.title} items={c.qa.items} />

  <section id="aula-experimental" class="section-pad bg-[#0099ff] text-center text-white"><div class="site-shell"><h2 class="font-serif text-4xl md:text-6xl">{c.trialTitle}</h2><p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/85">{c.trialText}</p><div class="mt-8"><FormModal id={formId} title={c.trialTitle} trigger={c.trialLabel} url={c.formUrl} directLabel={c.directLabel} closeLabel={c.closeLabel} /></div></div></section>
  <p slot="footer-note" class="text-sm leading-6 text-white/65">{chrome.footerNote.areas}<br />{chrome.footerNote.orgType}</p>
</Base>
