---
import Base from '../layouts/Base.astro'; import { getContent } from '../lib/content'; import { siteNav, type Locale } from '../lib/i18n'
interface Props { locale: Locale } const { locale }=Astro.props; const c=getContent('contact',locale)
const ui={pt:['Aikido · Lisboa','Menu','Saltar para o conteúdo','Associação sem fins lucrativos'],es:['Aikido · Lisboa','Menú','Saltar al contenido','Asociación sin fines de lucro'],fr:['Aïkido · Lisbonne','Menu','Aller au contenu','Association à but non lucratif'],en:['Aikido · Lisbon','Menu','Skip to content','Non-profit association']}[locale]
---
<Base page="contact" locale={locale} title={c.seo.title} description={c.seo.description} skipLink={ui[2]} nav={siteNav(locale)} menuLabel={ui[1]} caption={ui[0]}>
<section class="section-pad bg-[#9b3025] text-center text-white"><div class="site-shell"><p class="section-kicker text-[#f4c9b6]">{c.eyebrow}</p><h1 class="mx-auto mt-4 max-w-3xl font-serif text-5xl md:text-7xl">{c.title}</h1><p class="mx-auto mt-6 max-w-2xl text-xl leading-9 text-white/80">{c.lead}</p></div></section>
<section class="section-pad bg-[#f6f1e8]"><div class="site-shell grid gap-6 md:grid-cols-3">{c.venues.map((venue,index)=><article class="border border-[#d7cec0] bg-white p-7"><p class="section-kicker">0{index+1} · {venue.area}</p><h2 class="mt-4 font-serif text-2xl">{venue.name}</h2><ul class="mt-6 space-y-3 border-t border-[#d7cec0] pt-5 text-[#625c55]">{venue.transport.map(item=><li>{item}</li>)}</ul></article>)}</div></section>
<section class="section-pad bg-white"><div class="site-shell grid gap-12 md:grid-cols-[.75fr_1.25fr] md:gap-20"><div><h2 class="section-title">{c.privateTitle}</h2><p class="mt-5 text-lg leading-8 text-[#625c55]">{c.privateText}</p></div><form class="grid gap-5" aria-describedby="form-pending"><h2 class="font-serif text-3xl">{c.formTitle}</h2><label>{c.fields.name}<input class="mt-2 min-h-12 w-full border border-[#bfb5a7] p-3" name="name" autocomplete="name" /></label><label>{c.fields.email}<input class="mt-2 min-h-12 w-full border border-[#bfb5a7] p-3" type="email" name="email" autocomplete="email" /></label><label>{c.fields.subject}<input class="mt-2 min-h-12 w-full border border-[#bfb5a7] p-3" name="subject" /></label><label>{c.fields.message}<textarea class="mt-2 min-h-36 w-full border border-[#bfb5a7] p-3" name="message"></textarea></label><button class="button bg-[#9b3025] text-white opacity-60" type="button" disabled>{c.fields.submit}</button><p id="form-pending" class="text-sm text-[#756e66]">{c.fields.pending}</p></form></div></section>
<p slot="footer-note" class="text-sm text-white/65">Benfica · Lumiar · Encarnação<br />{ui[3]}</p></Base>
