---
import Base from '../layouts/Base.astro'; import { getContent } from '../lib/content'; import { getDojos } from '../lib/dojos'; import { siteNav, type Locale } from '../lib/i18n'
interface Props { locale: Locale } const { locale }=Astro.props; const c=getContent('contact',locale)
/**
 * Las sedes son la entidad de dojos, no texto repetido en cuatro idiomas (ADR-0038):
 * archivar un dojo lo saca de aca, igual que ya lo sacaba de `/aulas` y de la Home. Lo
 * unico que sigue siendo contenido traducible es **como se llega**, indexado por `slug`.
 *
 * Los cinco textos del borde tambien estaban escritos aca adentro (spec 0042).
 */
const chrome = c.chrome
const dojos = getDojos()
const comoLlegar = (slug: string): string[] => c.transport[slug] ?? []

/** `01`, `02`… y `10` con dos digitos, no `010`. */
const numero = (index: number) => String(index + 1).padStart(2, '0')
---
<Base page="contact" locale={locale} title={c.seo.title} description={c.seo.description} skipLink={chrome.skipLink} nav={siteNav(locale)} menuLabel={chrome.menuLabel} caption={chrome.caption}>
<section class="section-pad bg-[#0099ff] text-center text-white"><div class="site-shell"><p class="section-kicker text-[#d6f0ff]">{c.eyebrow}</p><h1 class="mx-auto mt-4 max-w-3xl font-serif text-5xl md:text-7xl">{c.title}</h1><p class="mx-auto mt-6 max-w-2xl text-xl leading-9 text-white/80">{c.lead}</p></div></section>
<section class="section-pad bg-[#f6f1e8]"><div class="site-shell grid gap-6 md:grid-cols-3">{dojos.map((dojo,index)=><article class="border border-[#d7cec0] bg-white p-7"><p class="section-kicker">{numero(index)} · {dojo.nombre}</p><h2 class="mt-4 font-serif text-2xl">{dojo.dojo}</h2>{comoLlegar(dojo.slug).length>0&&<ul class="mt-6 space-y-3 border-t border-[#d7cec0] pt-5 text-[#625c55]">{comoLlegar(dojo.slug).map(item=><li>{item}</li>)}</ul>}</article>)}</div></section>
<section class="section-pad bg-white"><div class="site-shell grid gap-12 md:grid-cols-[.75fr_1.25fr] md:gap-20"><div><h2 class="section-title">{c.privateTitle}</h2><p class="mt-5 text-lg leading-8 text-[#625c55]">{c.privateText}</p></div><form class="grid gap-5" aria-describedby="form-pending"><h2 class="font-serif text-3xl">{c.formTitle}</h2><label>{c.fields.name}<input class="mt-2 min-h-12 w-full border border-[#bfb5a7] p-3" name="name" autocomplete="name" /></label><label>{c.fields.email}<input class="mt-2 min-h-12 w-full border border-[#bfb5a7] p-3" type="email" name="email" autocomplete="email" /></label><label>{c.fields.subject}<input class="mt-2 min-h-12 w-full border border-[#bfb5a7] p-3" name="subject" /></label><label>{c.fields.message}<textarea class="mt-2 min-h-36 w-full border border-[#bfb5a7] p-3" name="message"></textarea></label><button class="button bg-[#0099ff] text-white opacity-60" type="button" disabled>{c.fields.submit}</button><p id="form-pending" class="text-sm text-[#756e66]">{c.fields.pending}</p></form></div></section>
<p slot="footer-note" class="text-sm text-white/65">{chrome.footerNote.areas}<br />{chrome.footerNote.orgType}</p></Base>
