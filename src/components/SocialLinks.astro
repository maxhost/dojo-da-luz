---
interface Props { class?: string }
const { class: className = '' } = Astro.props
const socialLinks = [
  { name: 'Facebook', href: 'https://www.facebook.com/aikidopabloduran/' },
]
---

<ul class:list={['m-0 flex list-none items-center gap-2 p-0', className]}>
  {socialLinks.map((social) => (
    <li>
      <a href={social.href} target="_blank" rel="me noopener noreferrer" aria-label={`${social.name} — Dojo da Luz`} title={social.name} class="grid size-9 place-items-center rounded-full border border-current transition-colors hover:border-[#9b3025] hover:text-[#9b3025]">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-current"><path d="M13.5 22v-9h3l.45-3.5H13.5V7.27c0-1.01.28-1.7 1.73-1.7H17V2.44A23.8 23.8 0 0 0 14.39 2C11.8 2 10 3.58 10 6.48V9.5H7V13h3v9h3.5Z" /></svg>
        <span class="sr-only">{social.name}</span>
      </a>
    </li>
  ))}
</ul>
