---
import { getAjustes } from '../lib/ajustes'

/**
 * Las URLs estaban escritas aca (spec 0044): ahora salen de `content/site.json` y se
 * editan en `/admin/ajustes`.
 *
 * **Sin dato no hay icono.** Un perfil que no se verifico no se publica (ADR-0014), y la
 * forma de no publicarlo es dejar el campo vacio, no un enlace a ninguna parte. WhatsApp
 * sigue la misma regla aunque guarda un numero, no una URL: sin numero, no hay wa.me.
 */

interface Props { class?: string }
const { class: className = '' } = Astro.props
const { redes } = getAjustes()

// WhatsApp guarda un numero, no una URL: el enlace de wa.me se arma con los digitos, sin
// el "+" ni espacios ni parentesis — es lo unico que wa.me acepta en el path.
const digitosWhatsapp = redes.whatsapp?.replace(/\D/g, '') ?? ''

const socialLinks = [
  { name: 'Facebook', href: redes.facebook, icon: 'facebook' },
  { name: 'Instagram', href: redes.instagram, icon: 'instagram' },
  { name: 'WhatsApp', href: digitosWhatsapp ? `https://wa.me/${digitosWhatsapp}` : null, icon: 'whatsapp' },
].filter((social): social is { name: string; href: string; icon: string } => social.href !== null)
---

{socialLinks.length > 0 && (
<ul class:list={['m-0 flex list-none items-center gap-2 p-0', className]}>
  {socialLinks.map((social) => (
    <li>
      <a href={social.href} target="_blank" rel="me noopener noreferrer" aria-label={`${social.name} — Dojo da Luz`} title={social.name} class="grid size-9 place-items-center rounded-full border border-current transition-colors hover:border-acento hover:text-acento">
        {social.icon === 'facebook' ? (
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-current"><path d="M13.5 22v-9h3l.45-3.5H13.5V7.27c0-1.01.28-1.7 1.73-1.7H17V2.44A23.8 23.8 0 0 0 14.39 2C11.8 2 10 3.58 10 6.48V9.5H7V13h3v9h3.5Z" /></svg>
        ) : social.icon === 'instagram' ? (
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-[1.8]"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.4" cy="6.6" r=".8" class="fill-current stroke-none" /></svg>
        ) : (
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-current"><path d="M12 2a10 10 0 0 0-8.55 15.15L2 22l4.98-1.4A10 10 0 1 0 12 2Zm0 18.2a8.16 8.16 0 0 1-4.24-1.18l-.3-.18-3.02.85.86-2.95-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.14c-.25-.12-1.45-.71-1.67-.8-.22-.08-.39-.12-.55.12-.16.25-.63.8-.78.96-.14.16-.28.18-.53.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.22-1.46-1.37-1.7-.14-.25-.02-.38.1-.5.12-.12.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.04-.43-.08-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.65.31-.22.24-.86.84-.86 2.05 0 1.21.88 2.38 1 2.54.12.16 1.73 2.64 4.2 3.71.59.25 1.04.4 1.4.52.59.19 1.12.16 1.55.1.47-.07 1.45-.6 1.66-1.17.2-.57.2-1.07.14-1.17-.06-.1-.22-.16-.47-.28Z" /></svg>
        )}
        <span class="sr-only">{social.name}</span>
      </a>
    </li>
  ))}
</ul>
)}
