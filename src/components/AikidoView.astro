---
import Base from '../layouts/Base.astro'
import { getContent } from '../lib/content'
import { pathFor, siteNav, type Locale } from '../lib/i18n'
interface Props { locale: Locale }
const { locale } = Astro.props
const c = getContent('aikido', locale)
// Los cinco textos del borde y las dos fotos estaban escritos aca adentro: no habia nada
// que editar aunque hubiera editor (spec 0037). Ahora salen del contenido.
const chrome = c.chrome

/** `01`, `02`… y `10` con dos digitos, no `010`. */
const numero = (index: number) => String(index + 1).padStart(2, '0')
---
<Base page="aikido" locale={locale} title={c.seo.title} description={c.seo.description} skipLink={chrome.skipLink} nav={siteNav(locale)} menuLabel={chrome.menuLabel} caption={chrome.caption}>
  <section class="relative isolate flex min-h-[31rem] items-end overflow-hidden bg-[#292522] text-center text-white md:min-h-[36rem]">
    <img src={c.heroPhoto} alt="" class="absolute inset-0 -z-20 h-full w-full object-cover" fetchpriority="high" />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/65"></div>
    <div class="site-shell py-16 md:py-20"><p class="section-kicker text-[#b3e5ff]">{c.eyebrow}</p><h1 class="mx-auto mt-5 max-w-4xl font-serif text-5xl leading-[1.04] md:text-7xl">{c.title}</h1><p class="mx-auto mt-6 max-w-2xl text-xl leading-9 text-white/75">{c.lead}</p></div>
  </section>
  <section class="bg-[#f6f1e8]"><div class="site-shell divide-y divide-[#d7cec0]">{c.sections.map((section,index) => <article id={`seccion-${index + 1}`} class="grid gap-8 py-16 md:grid-cols-[.45fr_1fr] md:gap-20 md:py-20"><div><p class="section-kicker">{numero(index)}</p><h2 class="mt-4 font-serif text-3xl leading-tight md:text-4xl">{section.title}</h2></div><div>{section.paragraphs.map((p) => <p class="mt-5 text-lg leading-8 text-[#4c4741] first:mt-0">{p}</p>)}</div></article>)}</div></section>
  <section class="section-pad bg-white"><div class="site-shell grid gap-10 md:grid-cols-[.55fr_1fr] md:gap-20"><div><p class="section-kicker">{c.founder.label}</p><h2 class="mt-4 font-serif text-4xl md:text-5xl">{c.founder.title}</h2><p class="mt-3 text-sm font-bold tracking-[.14em] text-[#0099ff]">{c.founder.years}</p></div><div>{c.founder.paragraphs.map((p)=><p class="mt-5 text-lg leading-8 text-[#4c4741] first:mt-0">{p}</p>)}<figure class="mx-auto mt-10 max-w-xl md:mx-0"><img src={c.founder.photo} alt={c.founder.photoAlt} class="w-full" loading="lazy" /></figure></div></div></section>
  <section class="section-pad bg-[#0099ff] text-center text-white"><div class="site-shell"><h2 class="font-serif text-4xl md:text-5xl">{c.audienceTitle}</h2><div class="mt-8 flex flex-wrap justify-center gap-3"><a class="button bg-white text-[#006eb8]" href={pathFor('adults',locale)}>{c.adultsLabel}</a><a class="button border border-white text-white" href={pathFor('children',locale)}>{c.childrenLabel}</a></div></div></section>
  <p slot="footer-note" class="text-sm leading-6 text-white/65">{chrome.footerNote.areas}<br />{chrome.footerNote.orgType}</p>
</Base>
