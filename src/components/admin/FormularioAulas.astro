---
import CampoFormulario from './CampoFormulario.astro'
import CampoImagen from './CampoImagen.astro'
import CampoTexto from './CampoTexto.astro'
import TablaFilas from './TablaFilas.astro'
import { errorDe } from '../../lib/forms'
import { LOCALES, LOCALE_NAME, type Locale } from '../../lib/i18n'
import { CLAVES_MEDIA, type Media } from '../../lib/media'

/**
 * Formulario de `/aulas` para un idioma (spec 0035). Los cuatro se pintan a la vez, como
 * en el editor de Home: cambiar de pestaña es CSS, no una navegacion, asi que lo escrito
 * y sin guardar sigue ahi al volver.
 *
 * La diferencia con Home es el ADR-0030: **solo la pestaña portuguesa puede agregar y
 * quitar filas**. Las otras tres reciben `editable={false}` y solo traducen.
 */

interface Props {
  locale: Locale
  datos: Record<string, any>
  errores: Record<string, string>
  shas: Record<Locale, string>
  medios: Media
  shaMedia: string
  /** Ruta de lista → indices cuyo texto sigue siendo el portugues. */
  sinTraducir: Record<string, number[]>
  /** Los formularios publicados, para elegir cuál abre el botón (spec 0050). */
  formularios: { id: string; nombre: string; estado: 'activo' | 'archivado' }[]
}

const { locale, datos, errores, shas, medios, shaMedia, sinTraducir, formularios = [] } = Astro.props

const esPortugues = locale === 'pt'

const v = (ruta: string): string =>
  ruta.split('.').reduce<any>((actual, clave) => actual?.[clave], datos) ?? ''
const lista = (ruta: string): any[] =>
  ruta.split('.').reduce<any>((actual, clave) => actual?.[clave], datos) ?? []
const e = (ruta: string) => errorDe(errores, ruta)

/** Las tablas de una columna guardan textos sueltos: la fila es `{ valor }`. */
const textos = (ruta: string) => lista(ruta).map((valor: string) => ({ valor }))

const seccion = 'scroll-mt-36 rounded-xl border border-[#d7cec0] bg-white p-4 shadow-[0_1px_2px_rgba(33,31,28,0.04)] sm:p-6 xl:col-start-2'

const secciones = [
  ['seo', 'SEO'],
  ['cabecera', 'Cabecera'],
  ['portada', 'Portada'],
  ['horarios', '01 · Horários'],
  ['cuotas', '02 · Quotas'],
  ['criancas', '03 · Crianças'],
  ['preguntas', '04 · Preguntas frecuentes'],
  ['experimental', '05 · Aula experimental'],
] as const

const campo = (nombre: string, etiqueta: string, extra: Record<string, unknown> = {}) => ({
  idPrefijo: locale,
  nombre,
  etiqueta,
  valor: v(nombre),
  error: e(nombre),
  requerido: true,
  ...extra,
})
---

<form method="post" class="grid gap-4 xl:grid-cols-[12rem_minmax(0,1fr)] xl:items-start xl:gap-x-7" data-editor-secciones>
  <input type="hidden" name="idioma" value={locale} />
  <input type="hidden" name="shaMedia" value={shaMedia} />
  {/* Los cuatro `sha`: publicar portugues toca los cuatro archivos y los verifica todos. */}
  {LOCALES.map((otro) => <input type="hidden" name={`sha.${otro}`} value={shas[otro]} />)}
  {/* Las imagenes que esta pagina no edita viajan igual: `media.json` se guarda entero. */}
  {CLAVES_MEDIA.filter((clave) => clave !== 'classesHero').map((clave) => (
    <input type="hidden" name={`media.${clave}`} value={medios[clave]} />
  ))}

  {!esPortugues && (
    <p class="rounded-lg border border-[#0099ff]/30 bg-[#eaf6ff] p-4 text-sm leading-6 text-[#211f1c] xl:col-span-2">
      Acá se traduce, no se cambia la estructura. Para agregar o quitar una fila de
      cualquier lista, andá a la pestaña <strong>Português</strong>: lo que agregues ahí
      aparece en los cuatro idiomas.
    </p>
  )}

  <nav class="rounded-lg border border-[#d7cec0] bg-[#fbf8f2] p-3 xl:sticky xl:top-5 xl:row-span-9" aria-label="Secciones de Aulas">
    <label class="block text-xs font-bold uppercase tracking-[0.12em] text-[#625c55]" for={`seccion-aulas-${locale}`}>Ir a una sección</label>
    <select id={`seccion-aulas-${locale}`} class="mt-2 min-h-11 w-full rounded-md border border-[#c9c0b3] bg-white px-3 text-sm xl:hidden" data-ir-seccion>
      <option value="">Elegir…</option>
      {secciones.map(([id, etiqueta]) => <option value={`${locale}-aulas-${id}`}>{etiqueta}</option>)}
    </select>
    <ol class="hidden space-y-0.5 xl:mt-3 xl:block">
      {secciones.map(([id, etiqueta]) => <li><a class="block rounded-md px-2.5 py-2 text-xs leading-4 text-[#625c55] no-underline hover:bg-[#eae4da] hover:text-[#211f1c]" href={`#${locale}-aulas-${id}`}>{etiqueta}</a></li>)}
    </ol>
  </nav>

  <fieldset class={seccion} id={`${locale}-aulas-seo`}>
    <legend class="px-2 font-serif text-xl">SEO</legend>
    <CampoTexto {...campo('seo.title', 'Título de la página', { recomendado: 60, ayuda: 'Lo que se lee como titular en Google y en la pestaña del navegador.' })} />
    <CampoTexto {...campo('seo.description', 'Descripción', { tipo: 'area', recomendado: 155, ayuda: 'El párrafo que Google muestra debajo del título.' })} />
  </fieldset>

  <fieldset class={seccion} id={`${locale}-aulas-cabecera`}>
    <legend class="px-2 font-serif text-xl">Cabecera</legend>
    <CampoTexto {...campo('chrome.caption', 'Bajada del logo')} />
    <CampoTexto {...campo('chrome.menuLabel', 'Botón de menú')} />
    <CampoTexto {...campo('chrome.skipLink', 'Saltar al contenido')} />
  </fieldset>

  <fieldset class={seccion} id={`${locale}-aulas-portada`}>
    <legend class="px-2 font-serif text-xl">Portada</legend>
    <CampoTexto {...campo('hero.eyebrow', 'Antetítulo')} />
    <CampoTexto {...campo('hero.title', 'Titular')} />
    <CampoTexto {...campo('hero.lead', 'Bajada', { tipo: 'area' })} />
    <CampoTexto {...campo('hero.season', 'Temporada')} />
    <CampoTexto {...campo('hero.ctaLabel', 'Texto del botón')} />
    <CampoImagen
      idPrefijo={locale}
      nombre="media.classesHero"
      etiqueta="Foto de portada"
      valor={medios.classesHero}
      errores={errores}
      ayuda="Es la misma en los cuatro idiomas."
    />
  </fieldset>

  <fieldset class={seccion} id={`${locale}-aulas-horarios`}>
    <legend class="px-2 font-serif text-xl">01 · Horários</legend>
    <p class="text-xs text-[#625c55]">
      Las sedes y sus horarios no se editan acá: son fichas de dojo. Se cambian en
      <a class="underline" href="/admin/dojos">Dojos</a>, y archivar uno lo saca de esta página.
    </p>
    <CampoTexto {...campo('schedule.label', 'Rótulo')} />
    <CampoTexto {...campo('schedule.title', 'Título')} />
    <CampoTexto {...campo('schedule.intro', 'Introducción', { tipo: 'area' })} />
    <CampoTexto {...campo('schedule.adultsLabel', 'Texto del botón de adultos')} />
    <CampoTexto {...campo('schedule.childrenLabel', 'Texto del botón de crianças')} />
  </fieldset>

  <fieldset class={seccion} id={`${locale}-aulas-cuotas`}>
    <legend class="px-2 font-serif text-xl">02 · Quotas</legend>
    <CampoTexto {...campo('pricing.label', 'Rótulo')} />
    <CampoTexto {...campo('pricing.title', 'Título')} />
    <CampoTexto {...campo('pricing.intro', 'Introducción', { tipo: 'area' })} />

    <TablaFilas
      titulo="Cuotas"
      prefijo="pricing.items"
      columnas={[
        { campo: 'name', etiqueta: 'Nombre' },
        { campo: 'price', etiqueta: 'Precio' },
        { campo: 'detail', etiqueta: 'Detalle' },
      ]}
      filas={lista('pricing.items')}
      errores={errores}
      idPrefijo={locale}
      editable={esPortugues}
      sinTraducir={sinTraducir['pricing.items'] ?? []}
    />

    <TablaFilas
      titulo="Notas"
      prefijo="pricing.notes"
      columnas={[{ campo: 'valor', etiqueta: 'Nota', tipo: 'area' }]}
      filas={textos('pricing.notes')}
      errores={errores}
      idPrefijo={locale}
      editable={esPortugues}
      sinTraducir={sinTraducir['pricing.notes'] ?? []}
      ayuda="Las aclaraciones que van debajo de la tabla de cuotas."
    />
  </fieldset>

  <fieldset class={seccion} id={`${locale}-aulas-criancas`}>
    <legend class="px-2 font-serif text-xl">03 · Crianças e adolescentes</legend>
    <CampoTexto {...campo('children.label', 'Rótulo')} />
    <CampoTexto {...campo('children.title', 'Título')} />

    <TablaFilas
      titulo="Párrafos"
      prefijo="children.paragraphs"
      columnas={[{ campo: 'valor', etiqueta: 'Párrafo', tipo: 'area' }]}
      filas={textos('children.paragraphs')}
      errores={errores}
      idPrefijo={locale}
      editable={esPortugues}
      sinTraducir={sinTraducir['children.paragraphs'] ?? []}
    />

    <TablaFilas
      titulo="Datos"
      prefijo="children.facts"
      columnas={[
        { campo: 'label', etiqueta: 'Etiqueta' },
        { campo: 'value', etiqueta: 'Valor' },
      ]}
      filas={lista('children.facts')}
      errores={errores}
      idPrefijo={locale}
      editable={esPortugues}
      sinTraducir={sinTraducir['children.facts'] ?? []}
    />
  </fieldset>

  <fieldset class={seccion} id={`${locale}-aulas-preguntas`}>
    <legend class="px-2 font-serif text-xl">04 · Perguntas frequentes</legend>
    <CampoTexto {...campo('qa.label', 'Rótulo')} />
    <CampoTexto {...campo('qa.title', 'Título')} />

    <TablaFilas
      titulo="Preguntas"
      prefijo="qa.items"
      columnas={[
        { campo: 'pregunta', etiqueta: 'Pregunta' },
        { campo: 'respuesta', etiqueta: 'Respuesta', tipo: 'area' },
      ]}
      filas={lista('qa.items')}
      errores={errores}
      idPrefijo={locale}
      editable={esPortugues}
      sinTraducir={sinTraducir['qa.items'] ?? []}
      ayuda="Estas preguntas también se publican como dato estructurado que Google lee. Respuestas de una o dos frases completas."
    />
  </fieldset>

  <fieldset class={seccion} id={`${locale}-aulas-experimental`}>
    <legend class="px-2 font-serif text-xl">05 · Aula experimental</legend>
    <CampoTexto {...campo('trial.label', 'Rótulo')} />
    <CampoTexto {...campo('trial.title', 'Título')} />
    <CampoTexto {...campo('trial.text', 'Texto', { tipo: 'area' })} />
    <CampoTexto {...campo('trial.note', 'Nota')} />
    <CampoTexto {...campo('trial.ctaLabel', 'Texto del botón')} />
    <CampoFormulario
      nombre="trial.formId"
      etiqueta="Formulario que abre el botón"
      valor={v('trial.formId')}
      formularios={formularios}
      editable={esPortugues}
      error={e('trial.formId')}
      idPrefijo={locale}
    />
    <CampoTexto {...campo('trial.directLabel', 'Enlace para abrir el formulario aparte')} />
    <CampoTexto {...campo('trial.closeLabel', 'Texto para cerrar')} />
    <p class="mt-4 text-xs text-[#625c55]">
      El botón abre el mismo formulario que Adultos. Cambiar a dónde apunta no se hace
      desde acá todavía.
    </p>
  </fieldset>

  <div class="sticky bottom-3 z-10 rounded-xl border border-[#d7cec0] bg-[#fbf8f2]/95 p-3 shadow-[0_8px_30px_rgba(33,31,28,0.16)] backdrop-blur xl:col-start-2 xl:flex xl:items-center xl:justify-between">
    <p class="mb-2 text-xs text-[#625c55] xl:mb-0">
      {esPortugues ? 'También se actualizará la estructura de los demás idiomas.' : 'Los cambios afectan solamente a este idioma.'}
    </p>
    <button class="min-h-12 w-full rounded-md bg-[#0099ff] px-6 font-semibold text-white transition hover:bg-[#0077c7] focus:outline-none focus:ring-2 focus:ring-[#0099ff] focus:ring-offset-2 xl:w-auto" type="submit">Publicar {LOCALE_NAME[locale]}</button>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLSelectElement>('[data-ir-seccion]').forEach((selector) => {
    if (selector.dataset.inicializado) return
    selector.dataset.inicializado = 'si'
    selector.addEventListener('change', () => {
      if (!selector.value) return
      document.getElementById(selector.value)?.scrollIntoView({ behavior: 'smooth', block: 'start' })
      selector.value = ''
    })
  })
</script>
