---
import { errorDe } from '../../lib/forms'

/**
 * El video de fondo de la portada (spec 0047, ADR-0044). Mismo contrato que `CampoImagen`
 * —se sube al elegir, no se publica hasta guardar la página— pero el archivo no pasa por
 * la función: va prefirmado directo a R2, porque Vercel corta el cuerpo en 4,5 MB y un
 * `.mp4` nunca entra por ahí.
 *
 * Vacío es un estado válido: la portada se ve solo con el póster. Por eso hay un botón
 * para quitar el video, y no solo para cambiarlo.
 */

interface Props {
  nombre: string
  etiqueta: string
  valor: string
  errores: Record<string, string>
  ayuda?: string
  idPrefijo?: string
}

const { nombre, etiqueta, valor, errores, ayuda, idPrefijo } = Astro.props

const id = `${idPrefijo ? `${idPrefijo}-` : ''}${nombre.replace(/[^a-zA-Z0-9]+/g, '-')}`
const error = errorDe(errores, nombre)
---

<div class="mt-5 rounded-lg border border-[#e2dbd0] bg-[#f7f3ec] p-3.5 sm:p-4" data-campo-video={true}>
  <p class="text-sm font-semibold">{etiqueta}</p>

  {ayuda && <p class="mt-1 text-xs text-[#625c55]" id={`${id}-ayuda`}>{ayuda}</p>}

  <video class="mt-3 block aspect-[3/2] w-full max-w-64 rounded-md border border-[#d7cec0] bg-[#1f1b16] object-cover" controls muted hidden={!valor} data-previa src={valor || undefined}></video>

  <div class="mt-3 flex flex-wrap gap-2">
    <button
      class="min-h-11 cursor-pointer rounded-md border border-[#c9c0b3] bg-white px-3.5 text-xs font-semibold transition hover:border-[#0099ff] focus:outline-none focus:ring-2 focus:ring-[#0099ff]/25"
      type="button"
      data-abrir
    >
      <span data-rotulo>{valor ? 'Cambiar vídeo' : 'Subir vídeo'}</span>
    </button>
    <button
      class="min-h-11 cursor-pointer rounded-md border border-transparent px-3.5 text-xs font-semibold text-[#8a5a3c] transition hover:underline focus:outline-none focus:ring-2 focus:ring-[#0099ff]/25"
      type="button"
      hidden={!valor}
      data-quitar
    >
      Quitar vídeo
    </button>
  </div>

  <input class="sr-only" type="file" accept="video/mp4" tabindex="-1" aria-hidden="true" data-archivo />

  <p class="mt-1 text-xs text-[#625c55]" role="status" data-estado></p>

  <input id={id} name={nombre} type="hidden" value={valor} data-url />

  {error && (
    <p class="mt-1 text-xs font-semibold text-[#b3261e]" id={`${id}-error`} role="alert">{error}</p>
  )}
</div>

<script>
  const BYTES_MAXIMOS = 32 * 1024 * 1024
  const CONTENT_TYPE = 'video/mp4'

  const hashDe = async (archivo: File): Promise<string> => {
    const bytes = await crypto.subtle.digest('SHA-256', await archivo.arrayBuffer())
    return [...new Uint8Array(bytes)].map((b) => b.toString(16).padStart(2, '0')).join('')
  }

  const subirConProgreso = (url: string, archivo: File, onProgreso: (pct: number) => void): Promise<void> =>
    new Promise((resolve, reject) => {
      const xhr = new XMLHttpRequest()
      xhr.open('PUT', url)
      xhr.setRequestHeader('content-type', CONTENT_TYPE)
      xhr.upload.addEventListener('progress', (evento) => {
        if (evento.lengthComputable) onProgreso(Math.round((evento.loaded / evento.total) * 100))
      })
      xhr.addEventListener('load', () => {
        if (xhr.status >= 200 && xhr.status < 300) resolve()
        else reject(new Error(`R2 respondió ${xhr.status}`))
      })
      xhr.addEventListener('error', () => reject(new Error('No se pudo conectar con R2.')))
      xhr.send(archivo)
    })

  const inicializarCampoVideo = (campo: HTMLElement) => {
    if (campo.dataset.inicializado === 'si') return
    const url = campo.querySelector<HTMLInputElement>('[data-url]')
    const archivo = campo.querySelector<HTMLInputElement>('[data-archivo]')
    const abrir = campo.querySelector<HTMLButtonElement>('[data-abrir]')
    const quitar = campo.querySelector<HTMLButtonElement>('[data-quitar]')
    const estado = campo.querySelector<HTMLElement>('[data-estado]')
    const previa = campo.querySelector<HTMLVideoElement>('[data-previa]')
    const rotulo = campo.querySelector<HTMLElement>('[data-rotulo]')
    if (!url || !archivo || !abrir || !quitar || !estado || !previa || !rotulo) return

    campo.dataset.inicializado = 'si'

    const mostrar = (valor: string) => {
      previa.src = valor
      previa.hidden = !valor
      quitar.hidden = !valor
      rotulo.textContent = valor ? 'Cambiar vídeo' : 'Subir vídeo'
    }

    abrir.addEventListener('click', () => archivo.click())

    quitar.addEventListener('click', () => {
      url.value = ''
      mostrar('')
      estado.textContent = 'Vídeo quitado. No se publica hasta que guardes esta página.'
    })

    archivo.addEventListener('change', async () => {
      const elegido = archivo.files?.[0]
      if (!elegido) return

      if (elegido.type !== CONTENT_TYPE) {
        estado.textContent = 'Tiene que ser un archivo .mp4.'
        archivo.value = ''
        return
      }
      if (elegido.size > BYTES_MAXIMOS) {
        const mb = (elegido.size / 1024 / 1024).toFixed(1)
        estado.textContent = `El archivo pesa ${mb} MB y el máximo son 32 MB.`
        archivo.value = ''
        return
      }

      const temporal = URL.createObjectURL(elegido)
      previa.src = temporal
      previa.hidden = false
      archivo.disabled = true
      abrir.disabled = true
      quitar.disabled = true
      estado.textContent = 'Calculando…'

      try {
        const hash = await hashDe(elegido)
        estado.textContent = 'Firmando…'

        const resFirma = await fetch('/admin/medios/firmar', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ contentType: elegido.type, tamano: elegido.size, hash }),
        })
        const firma = (await resFirma.json()) as {
          url?: string | null
          urlPublica?: string
          requierePut?: boolean
          motivo?: string
        }

        if (!resFirma.ok || !firma.urlPublica) {
          estado.textContent = firma.motivo ?? `Error ${resFirma.status}`
          mostrar(url.value)
          return
        }

        if (firma.requierePut && firma.url) {
          estado.textContent = 'Subiendo… 0%'
          await subirConProgreso(firma.url, elegido, (pct) => {
            estado.textContent = `Subiendo… ${pct}%`
          })
        }

        url.value = firma.urlPublica
        mostrar(firma.urlPublica)
        estado.textContent = 'Listo. No se publica hasta que guardes esta página.'
        archivo.value = ''
      } catch (error) {
        estado.textContent = `No se pudo subir: ${error instanceof Error ? error.message : error}`
        mostrar(url.value)
      } finally {
        if (temporal) URL.revokeObjectURL(temporal)
        archivo.disabled = false
        abrir.disabled = false
        quitar.disabled = false
      }
    })
  }

  document.querySelectorAll<HTMLElement>('[data-campo-video]').forEach(inicializarCampoVideo)
</script>
