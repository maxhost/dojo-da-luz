---
import CampoImagen from './CampoImagen.astro'
import CampoTexto from './CampoTexto.astro'
import NavegacionEditor from './NavegacionEditor.astro'
import TablaMedios from './TablaMedios.astro'
import { errorDe } from '../../lib/forms'
import { LOCALES, LOCALE_NAME, type Locale } from '../../lib/i18n'

/**
 * El formulario de `/outras-artes` para un idioma (spec 0040). Los cuatro se pintan a la
 * vez: cambiar de pestaña es CSS, no una navegacion.
 *
 * **Cada arte es un bloque, no una fila de tabla.** Tiene once campos y tres listas
 * adentro: una tabla de tres filas por once columnas no se lee. Las tres listas van como
 * recuadro de texto, una entrada por renglon (ADR-0033).
 *
 * Las artes son tres y no se pueden añadir ni quitar (ADR-0036). Dos cosas solo pasan en
 * portugues: la galeria (ADR-0030) y cambiar una foto (ADR-0032).
 */

interface Props {
  locale: Locale
  datos: Record<string, any>
  errores: Record<string, string>
  shas: Record<Locale, string>
  /** Ruta de lista → indices cuyo texto sigue siendo el portugues. */
  sinTraducir: Record<string, number[]>
}

const { locale, datos, errores, shas, sinTraducir } = Astro.props

const esPortugues = locale === 'pt'

const v = (ruta: string): string =>
  ruta.split('.').reduce<any>((actual, clave) => actual?.[clave], datos) ?? ''
const lista = (ruta: string): any[] =>
  ruta.split('.').reduce<any>((actual, clave) => actual?.[clave], datos) ?? []
const e = (ruta: string) => errorDe(errores, ruta)

const artes = lista('activities')

const seccion = 'scroll-mt-36 rounded-xl border border-[#d7cec0] bg-white p-4 shadow-[0_1px_2px_rgba(33,31,28,0.04)] sm:p-6 xl:col-start-2'

const campo = (nombre: string, etiqueta: string, extra: Record<string, unknown> = {}) => ({
  idPrefijo: locale,
  nombre,
  etiqueta,
  valor: v(nombre),
  error: e(nombre),
  requerido: true,
  ...extra,
})

/** Un campo de un arte: mismo helper, con el prefijo de su posicion. */
const campoArte = (
  i: number,
  clave: string,
  etiqueta: string,
  extra: Record<string, unknown> = {},
) => ({
  idPrefijo: locale,
  nombre: `activities[${i}].${clave}`,
  etiqueta,
  valor: artes[i]?.[clave] ?? '',
  error: errorDe(errores, `activities.${i}.${clave}`),
  requerido: true,
  ...extra,
})

/** Una lista de adentro de un arte, como texto: un renglon por entrada. */
const renglones = (i: number, clave: string) => (artes[i]?.[clave] ?? []).join('\n')

/**
 * El numero del bloque en la pantalla, en orden: `01` es la portada y las artes siguen
 * desde `02`. **No es el numero que pinta la pagina publica** —ahi las artes empiezan en
 * `01`— y es a proposito: aca se numera lo que hay que recorrer para editar, que incluye
 * la portada y la galeria.
 */
const numero = (i: number) => String(i).padStart(2, '0')
const navegacion = [
  ['cabecera', 'Cabecera'],
  ['seo', 'SEO'],
  ['portada', '01 · Portada'],
  ...artes.map((arte: any, i: number) => [`arte-${i}`, `${numero(i + 2)} · ${arte.name}`] as const),
  ['galeria', `${numero(artes.length + 2)} · Galería`],
] as const
---

<form method="post" class="grid gap-4 xl:grid-cols-[12rem_minmax(0,1fr)] xl:items-start xl:gap-x-7">
  <input type="hidden" name="idioma" value={locale} />
  {/* Los cuatro `sha`: publicar portugues toca los cuatro archivos y los verifica todos. */}
  {LOCALES.map((otro) => <input type="hidden" name={`sha.${otro}`} value={shas[otro]} />)}

  {!esPortugues && (
    <p class="rounded-lg border border-[#0099ff]/30 bg-[#eaf6ff] p-4 text-sm leading-6 text-[#211f1c] xl:col-span-2">
      Acá se traduce. Para cambiar una foto o tocar la galería, andá a la pestaña
      <strong>Português</strong>: lo que hagas ahí aparece en los cuatro idiomas.
    </p>
  )}

  <div class="xl:sticky xl:top-5 xl:row-span-8"><NavegacionEditor locale={locale} prefijo="artes" titulo="Secciones de Outras artes" secciones={navegacion} /></div>

  <fieldset class={seccion} id={`${locale}-artes-cabecera`}><legend class="px-2 font-serif text-xl">Cabecera</legend>
    <CampoTexto {...campo('chrome.caption', 'Bajada del logo')} />
    <CampoTexto {...campo('chrome.menuLabel', 'Botón de menú')} />
    <CampoTexto {...campo('chrome.skipLink', 'Saltar al contenido')} />
  </fieldset>

  <fieldset class={seccion} id={`${locale}-artes-seo`}><legend class="px-2 font-serif text-xl">SEO</legend>
    <CampoTexto {...campo('seo.title', 'Título de la página', { recomendado: 60, ayuda: 'Lo que se lee como titular en Google y en la pestaña del navegador.' })} />
    <CampoTexto {...campo('seo.description', 'Descripción', { tipo: 'area', recomendado: 155, ayuda: 'El párrafo que Google muestra debajo del título.' })} />
  </fieldset>

  <fieldset class={seccion} id={`${locale}-artes-portada`}><legend class="px-2 font-serif text-xl">01 · Portada</legend>
    <CampoTexto {...campo('eyebrow', 'Antetítulo')} />
    <CampoTexto {...campo('title', 'Titular')} />
    <CampoTexto {...campo('lead', 'Bajada', { tipo: 'area' })} />
    <CampoImagen
      idPrefijo={locale}
      nombre="heroPhoto"
      etiqueta="Foto de fondo"
      valor={v('heroPhoto')}
      errores={errores}
      soloLectura={!esPortugues}
      ayuda="Va detrás del titular, con un velo oscuro encima. Es la misma en los cuatro idiomas y no lleva descripción: para un lector de pantalla es decoración."
    />
  </fieldset>

  {artes.map((arte: any, i: number) => (
    <fieldset class={seccion} id={`${locale}-artes-arte-${i}`}>
      <legend class="px-2 font-serif text-xl">{numero(i + 2)} · {arte.name}</legend>

      {/* El destino del formulario no se edita: un enlace mal escrito deja el modal en
          blanco sin avisar. Viaja oculto para no perderse al guardar. */}
      <input type="hidden" name={`activities[${i}].formUrl`} value={arte.formUrl ?? ''} />

      <CampoTexto {...campoArte(i, 'name', 'Nombre')} />
      <CampoTexto {...campoArte(i, 'subtitle', 'Subtítulo')} />

      <CampoImagen
        idPrefijo={locale}
        nombre={`activities[${i}].photo`}
        etiqueta="Foto"
        valor={arte.photo ?? ''}
        errores={errores}
        soloLectura={!esPortugues}
        ayuda="Es la misma en los cuatro idiomas."
      />
      <CampoTexto {...campoArte(i, 'photoAlt', 'Descripción de la foto', { ayuda: 'La leen los lectores de pantalla y Google.' })} />

      <CampoTexto {...campoArte(i, 'paragraphs', 'Párrafos (uno por línea)', { tipo: 'area', filas: 6, valor: renglones(i, 'paragraphs') })} />
      <CampoTexto {...campoArte(i, 'benefits', 'Beneficios (uno por línea)', { tipo: 'area', requerido: false, valor: renglones(i, 'benefits'), ayuda: 'Vacío: la página no pinta la lista.' })} />
      <CampoTexto {...campoArte(i, 'schedule', 'Horarios (uno por línea)', { tipo: 'area', requerido: false, valor: renglones(i, 'schedule'), ayuda: 'Vacío: la página no pinta el recuadro del horario.' })} />
      <CampoTexto {...campoArte(i, 'teacher', 'Profesor', { requerido: false, ayuda: 'Opcional. Solo se muestra si hay horarios.' })} />

      <CampoTexto {...campoArte(i, 'trialLabel', 'Texto del botón')} />
      <CampoTexto {...campoArte(i, 'directLabel', 'Enlace para abrir el formulario aparte')} />
      <CampoTexto {...campoArte(i, 'closeLabel', 'Texto para cerrar')} />

      {arte.formUrl === null && (
        <p class="mt-4 text-xs text-[#625c55]">
          Esta arte no tiene formulario propio: su botón lleva a la página de contacto.
        </p>
      )}
    </fieldset>
  ))}

  <fieldset class={seccion} id={`${locale}-artes-galeria`}>
    <legend class="px-2 font-serif text-xl">{numero(artes.length + 2)} · Galería</legend>
    <p class="text-xs text-[#625c55]">
      Fotos y vídeos de las tres artes, todos juntos al final de la página. Mientras esté
      vacía, la sección entera no aparece.
    </p>

    <CampoTexto {...campo('gallery.label', 'Rótulo')} />
    <CampoTexto {...campo('gallery.title', 'Título')} />
    <CampoTexto {...campo('gallery.intro', 'Introducción', { tipo: 'area' })} />

    <TablaMedios
      prefijo="gallery.items"
      filas={lista('gallery.items')}
      errores={errores}
      idPrefijo={locale}
      editable={esPortugues}
      sinTraducir={sinTraducir['gallery.items'] ?? []}
    />
  </fieldset>

  <div class="sticky bottom-3 z-10 rounded-xl border border-[#d7cec0] bg-[#fbf8f2]/95 p-3 shadow-[0_8px_30px_rgba(33,31,28,0.16)] backdrop-blur xl:col-start-2 xl:flex xl:items-center xl:justify-between">
    <p class="mb-2 text-xs text-[#625c55] xl:mb-0">{esPortugues ? 'También se actualizarán las fotos y la galería compartida.' : 'Los cambios afectan solamente a este idioma.'}</p>
    <button class="min-h-12 w-full rounded-md bg-[#0099ff] px-6 font-semibold text-white hover:bg-[#0077c7] xl:w-auto" type="submit">Publicar Outras artes en {LOCALE_NAME[locale]}</button>
  </div>
</form>
