---
/** Aviso del backoffice: resultado de un guardado o motivo por el que no se publico. */

interface Props {
  tipo: 'ok' | 'error'
}

const { tipo } = Astro.props

const estilo =
  tipo === 'ok'
    ? 'border-[#0099ff] bg-[#e6f6ff] text-[#0b5e8f]'
    : 'border-[#b3261e] bg-[#fdeceb] text-[#b3261e]'
---

<p class={`mt-6 border px-4 py-3 text-sm ${estilo}`} role="alert">
  <slot />
</p>
