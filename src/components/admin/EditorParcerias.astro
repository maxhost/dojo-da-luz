---
import CampoImagen from './CampoImagen.astro'
import { errorDe } from '../../lib/forms'
import type { FilaParceiro } from '../../lib/forms'

/**
 * Lista de parceiros de la seccion 06 (spec 0031). Formulario propio, con su propio `sha`:
 * los logos son los mismos en los cuatro idiomas (ADR-0027), asi que no viven en las
 * pestañas de idioma ni se publican con ellas.
 *
 * Se muestran solamente los logos publicados. "Añadir nuevo" crea un cargador y cada logo
 * se puede sacar de la lista con su propio boton. El cambio llega a la Home al publicar.
 */

interface Props {
  partners: FilaParceiro[]
  errores: Record<string, string>
  sha: string
}

const { partners, errores, sha } = Astro.props

const err = (i: number, campo: string) => errorDe(errores, `${i}.${campo}`)
---

<form method="post">
  <input type="hidden" name="formulario" value="parcerias" />
  <input type="hidden" name="sha" value={sha} />

  <p class="mt-2 text-sm leading-6 text-[#625c55]">
    Los mismos en los cuatro idiomas. Se ven en la portada en este orden.
  </p>

  <ol class="mt-5 grid list-none gap-3 p-0 sm:grid-cols-2 lg:grid-cols-3" data-lista-logos>
    {partners.map((partner, i) => (
      <li class="rounded-lg border border-[#d7cec0] bg-[#fbf8f2] p-3" data-logo>
        <CampoImagen
          idPrefijo={`parceiro-${i}`}
          nombre={`parceiros[${i}].src`}
          etiqueta={`Logo ${i + 1}`}
          valor={partner.src}
          errores={err(i, 'src') ? { [`parceiros[${i}].src`]: err(i, 'src')! } : {}}
          requerido={false}
        />

        {/* El nombre —lo que se lee sin ver la imagen— y la ampliacion de los logos que
            vienen con mucho margen viajan con la fila, pero no son cosas que el cliente
            tenga que decidir por cada logo (ADR-0029). */}
        <input type="hidden" name={`parceiros[${i}].nombre`} value={partner.nombre} />
        <input type="hidden" name={`parceiros[${i}].escala`} value={partner.escala ?? ''} />

        <button class="mt-3 text-xs font-semibold text-[#b3261e] underline" type="button" data-eliminar-logo>
          Eliminar
        </button>
      </li>
    ))}
  </ol>

  <template data-plantilla-logo>
    <li class="rounded-lg border border-[#d7cec0] bg-[#fbf8f2] p-3" data-logo>
      <CampoImagen
        idPrefijo="parceiro-nuevo"
        nombre="parceiros[__indice__].src"
        etiqueta="Logo nuevo"
        valor=""
        errores={{}}
        requerido={false}
      />
      <input type="hidden" name="parceiros[__indice__].nombre" value="" />
      <input type="hidden" name="parceiros[__indice__].escala" value="" />
      <button class="mt-3 text-xs font-semibold text-[#b3261e] underline" type="button" data-eliminar-logo>
        Eliminar
      </button>
    </li>
  </template>

  <button class="mt-5 min-h-11 rounded-md border border-[#1f1b16] bg-white px-5 py-2 text-sm font-semibold" type="button" data-anadir-logo>
    Añadir nuevo
  </button>

  <button
    class="mt-3 min-h-11 rounded-md border border-[#1f1b16] bg-[#1f1b16] px-5 py-2 text-sm font-semibold text-[#f6f1e8] sm:ml-2"
    type="submit"
  >
    Publicar parcerías
  </button>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form').forEach((formulario) => {
    const lista = formulario.querySelector<HTMLOListElement>('[data-lista-logos]')
    const plantilla = formulario.querySelector<HTMLTemplateElement>('[data-plantilla-logo]')
    const anadir = formulario.querySelector<HTMLButtonElement>('[data-anadir-logo]')
    if (!lista || !plantilla || !anadir) return

    let siguiente = lista.querySelectorAll('[data-logo]').length

    formulario.addEventListener('click', (evento) => {
      const objetivo = evento.target
      if (!(objetivo instanceof Element)) return
      const eliminar = objetivo.closest<HTMLButtonElement>('[data-eliminar-logo]')
      if (eliminar) eliminar.closest('[data-logo]')?.remove()
    })

    anadir.addEventListener('click', () => {
      const fragmento = plantilla.content.cloneNode(true) as DocumentFragment
      fragmento.querySelectorAll<HTMLInputElement>('[name]').forEach((input) => {
        input.name = input.name.replace('__indice__', String(siguiente))
      })
      siguiente += 1
      const campo = fragmento.querySelector<HTMLElement>('[data-campo-imagen]')
      lista.append(fragmento)
      campo?.dispatchEvent(new CustomEvent('campo-imagen:inicializar', { bubbles: true }))
      campo?.querySelector<HTMLButtonElement>('[data-abrir]')?.click()
    })
  })
</script>
