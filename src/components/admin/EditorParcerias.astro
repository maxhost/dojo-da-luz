---
import CampoImagen from './CampoImagen.astro'
import CampoTexto from './CampoTexto.astro'
import { errorDe } from '../../lib/forms'
import type { FilaParceiro } from '../../lib/forms'

/**
 * Lista de parceiros de la seccion 06 (spec 0031). Formulario propio, con su propio `sha`:
 * los logos son los mismos en los cuatro idiomas (ADR-0027), asi que no viven en las
 * pestañas de idioma ni se publican con ellas.
 *
 * Largo libre sin JavaScript: se pinta siempre una fila vacia de mas. Llenarla agrega un
 * parceiro; vaciar una existente lo borra. No hay boton de borrar que se pueda apretar sin
 * querer, y por lo tanto no hace falta pedir confirmacion.
 */

interface Props {
  partners: FilaParceiro[]
  errores: Record<string, string>
  sha: string
}

const { partners, errores, sha } = Astro.props

// La fila de mas es la que permite agregar. `null` = fila nueva, sin valores.
const filas: (FilaParceiro | null)[] = [...partners, null]

const err = (i: number, campo: string) => errorDe(errores, `${i}.${campo}`)
---

<form method="post">
  <input type="hidden" name="formulario" value="parcerias" />
  <input type="hidden" name="sha" value={sha} />

  <p class="text-sm text-[#625c55]">
    Los logos son los mismos en los cuatro idiomas: se editan una sola vez, acá. El orden de
    esta lista es el orden en que se ven en la portada.
  </p>

  <ol class="mt-4 list-none space-y-4 p-0">
    {filas.map((partner, i) => (
      <li class="border border-[#d7cec0] bg-[#fbf8f2] p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-[#625c55]">
          {partner ? `Parceiro ${i + 1}` : 'Agregar un parceiro'}
        </p>

        <CampoTexto
          idPrefijo={`parceiro-${i}`}
          nombre={`parceiros[${i}].nombre`}
          etiqueta="Nombre"
          valor={partner?.nombre ?? ''}
          error={err(i, 'nombre')}
          ayuda="Se lee en voz alta a quien navega sin ver la imagen. No aparece en pantalla."
        />

        <CampoImagen
          idPrefijo={`parceiro-${i}`}
          nombre={`parceiros[${i}].src`}
          etiqueta="Logo"
          valor={partner?.src ?? ''}
          errores={err(i, 'src') ? { [`parceiros[${i}].src`]: err(i, 'src')! } : {}}
          requerido={false}
          ayuda="Se ve dentro de una franja de 80 px de alto, sin recuadro."
        />

        <CampoTexto
          idPrefijo={`parceiro-${i}`}
          nombre={`parceiros[${i}].escala`}
          etiqueta="Ampliación"
          tipo="number"
          paso="0.05"
          valor={partner?.escala ?? ''}
          error={err(i, 'escala')}
          ayuda="Opcional. Dejalo vacío salvo que el logo se vea chico porque el archivo trae mucho margen: 1.45 lo agranda un 45%."
        />

        {partner && (
          <p class="mt-3 text-xs text-[#625c55]">
            Para sacar este parceiro, borrá el nombre y la dirección del logo y publicá.
          </p>
        )}
      </li>
    ))}
  </ol>

  <button
    class="mt-6 border border-[#1f1b16] bg-[#1f1b16] px-5 py-2 text-sm font-semibold text-[#f6f1e8]"
    type="submit"
  >
    Publicar parcerías
  </button>
</form>
