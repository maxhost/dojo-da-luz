---
import CampoImagen from './CampoImagen.astro'
import CampoTexto from './CampoTexto.astro'
import { errorDe } from '../../lib/forms'
import { LOCALE_NAME, type Locale } from '../../lib/i18n'
import type { Media } from '../../lib/media'

/**
 * Formulario de la Home para un idioma (spec 0021). Todos los campos de `homeSchema`,
 * incluido el SEO y el resumen citable de la capa GEO (ADR-0018).
 *
 * Los cuatro idiomas se pintan a la vez, cada uno con su formulario: cambiar de idioma es
 * un cambio de pestaña en CSS, no una navegacion, asi que lo escrito y sin guardar sigue
 * ahi al volver.
 */

interface Props {
  locale: Locale
  /** Las imagenes viven en su propio archivo pero se editan aca (ADR-0029). */
  medios: Media
  shaMedia: string
  valores: Record<string, string>
  errores: Record<string, string>
  sha: string
}

const { locale, valores, errores, sha, medios, shaMedia } = Astro.props

const v = (ruta: string) => valores[ruta] ?? ''
const e = (ruta: string) => errorDe(errores, ruta)

const seccion = 'mt-8 border border-[#d7cec0] bg-[#fbf8f2] p-4'
---

<form method="post">
  <input type="hidden" name="idioma" value={locale} />
  <input type="hidden" name="sha" value={sha} />
  <input type="hidden" name="shaMedia" value={shaMedia} />

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">SEO</legend>
    <CampoTexto
      idPrefijo={locale}
      nombre="seo.title"
      etiqueta="Título de la página"
      valor={v('seo.title')}
      error={e('seo.title')}
      requerido
      recomendado={60}
      ayuda="Lo que se lee como titular en Google y en la pestaña del navegador."
    />
    <CampoTexto
      idPrefijo={locale}
      nombre="seo.description"
      etiqueta="Descripción"
      valor={v('seo.description')}
      error={e('seo.description')}
      tipo="area"
      requerido
      recomendado={155}
      ayuda="El párrafo que Google muestra debajo del título."
    />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">Resumen citable</legend>
    <p class="text-xs text-[#625c55]">
      De 2 a 4 frases completas, cada una con sujeto explícito: son las que ChatGPT o
      Google citan sin el resto de la página. Mínimo 40 caracteres por frase.
    </p>
    <CampoTexto
      idPrefijo={locale}
      nombre="resumen"
      etiqueta="Una frase por línea"
      valor={v('resumen')}
      error={e('resumen')}
      tipo="area"
      filas={5}
      requerido
      minimo={40}
    />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">Cabecera y pie</legend>
    <CampoTexto idPrefijo={locale} nombre="chrome.caption" etiqueta="Bajada del logo" valor={v('chrome.caption')} error={e('chrome.caption')} requerido />
    <CampoTexto idPrefijo={locale} nombre="chrome.menuLabel" etiqueta="Botón de menú" valor={v('chrome.menuLabel')} error={e('chrome.menuLabel')} requerido />
    <CampoTexto idPrefijo={locale} nombre="chrome.skipLink" etiqueta="Saltar al contenido" valor={v('chrome.skipLink')} error={e('chrome.skipLink')} requerido />
    <CampoTexto idPrefijo={locale} nombre="chrome.footerNote.areas" etiqueta="Pie · zonas" valor={v('chrome.footerNote.areas')} error={e('chrome.footerNote.areas')} requerido />
    <CampoTexto idPrefijo={locale} nombre="chrome.footerNote.orgType" etiqueta="Pie · tipo de organización" valor={v('chrome.footerNote.orgType')} error={e('chrome.footerNote.orgType')} requerido />

    <p class="mt-6 text-xs text-[#625c55]">
      El menú de la página no se edita desde acá: sus cuatro enlaces apuntan a secciones de
      esta misma página y un destino mal escrito rompe la navegación sin que nada lo avise.
    </p>
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">Portada</legend>
    <CampoTexto idPrefijo={locale} nombre="hero.eyebrowLines" etiqueta="Antetítulo (una línea por renglón)" valor={v('hero.eyebrowLines')} error={e('hero.eyebrowLines')} tipo="area" filas={2} requerido />
    <CampoTexto idPrefijo={locale} nombre="hero.titleLines" etiqueta="Titular (una línea por renglón)" valor={v('hero.titleLines')} error={e('hero.titleLines')} tipo="area" filas={2} requerido />
    <CampoTexto idPrefijo={locale} nombre="hero.titleHighlight" etiqueta="Última palabra destacada" valor={v('hero.titleHighlight')} error={e('hero.titleHighlight')} requerido />
    <CampoTexto idPrefijo={locale} nombre="hero.tagline" etiqueta="Bajada" valor={v('hero.tagline')} error={e('hero.tagline')} tipo="area" requerido />
    <CampoImagen idPrefijo={locale} nombre="media.heroPoster" etiqueta="Portada del vídeo" valor={medios.heroPoster} errores={errores} ayuda="Se ve mientras carga el vídeo, y en lugar del vídeo si no puede reproducirse. Es la misma en los cuatro idiomas." />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">01 · La práctica</legend>
    <CampoTexto idPrefijo={locale} nombre="practice.label" etiqueta="Rótulo" valor={v('practice.label')} error={e('practice.label')} requerido />
    <CampoTexto idPrefijo={locale} nombre="practice.titleLines" etiqueta="Título (una línea por renglón)" valor={v('practice.titleLines')} error={e('practice.titleLines')} tipo="area" filas={2} requerido />
    <CampoTexto idPrefijo={locale} nombre="practice.paragraphs" etiqueta="Párrafos (uno por línea)" valor={v('practice.paragraphs')} error={e('practice.paragraphs')} tipo="area" filas={4} requerido />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">02 · Audiencias</legend>
    <CampoTexto idPrefijo={locale} nombre="audiences.label" etiqueta="Rótulo" valor={v('audiences.label')} error={e('audiences.label')} requerido />
    <CampoTexto idPrefijo={locale} nombre="audiences.title" etiqueta="Título" valor={v('audiences.title')} error={e('audiences.title')} requerido />
    <CampoTexto idPrefijo={locale} nombre="audiences.intro" etiqueta="Introducción" valor={v('audiences.intro')} error={e('audiences.intro')} tipo="area" requerido />
    <CampoTexto idPrefijo={locale} nombre="audiences.adultsLabel" etiqueta="Etiqueta de adultos" valor={v('audiences.adultsLabel')} error={e('audiences.adultsLabel')} requerido />
    <CampoTexto idPrefijo={locale} nombre="audiences.childrenLabel" etiqueta="Etiqueta de niños" valor={v('audiences.childrenLabel')} error={e('audiences.childrenLabel')} requerido />
    <CampoTexto idPrefijo={locale} nombre="audiences.ctaLabel" etiqueta="Texto del botón" valor={v('audiences.ctaLabel')} error={e('audiences.ctaLabel')} requerido />

    {([
      ['adults', 'Tarjeta de adultos'],
      ['children', 'Tarjeta de niños y adolescentes'],
    ] as const).map(([clave, titulo]) => (
      <div class="mt-8 border-t border-[#e6ded0] pt-4">
        <p class="text-sm font-semibold">{titulo}</p>
        <CampoImagen idPrefijo={locale} nombre={clave === 'adults' ? 'media.adultsPhoto' : 'media.childrenPhoto'} etiqueta="Foto" valor={clave === 'adults' ? medios.adultsPhoto : medios.childrenPhoto} errores={errores} ayuda="Es la misma en los cuatro idiomas." />
        <CampoTexto idPrefijo={locale} nombre={`audiences.${clave}.photoAlt`} etiqueta="Texto alternativo de la foto" valor={v(`audiences.${clave}.photoAlt`)} error={e(`audiences.${clave}.photoAlt`)} requerido ayuda="Lo que lee quien no ve la imagen." />
        <CampoTexto idPrefijo={locale} nombre={`audiences.${clave}.title`} etiqueta="Título de la tarjeta" valor={v(`audiences.${clave}.title`)} error={e(`audiences.${clave}.title`)} requerido />
        <CampoTexto idPrefijo={locale} nombre={`audiences.${clave}.lead`} etiqueta="Texto de la tarjeta" valor={v(`audiences.${clave}.lead`)} error={e(`audiences.${clave}.lead`)} tipo="area" requerido />
      </div>
    ))}
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">03 · Los lugares</legend>
    <p class="text-xs text-[#625c55]">
      Las sedes y sus horarios no se editan acá: son fichas de dojo.
    </p>
    <CampoTexto idPrefijo={locale} nombre="places.label" etiqueta="Rótulo" valor={v('places.label')} error={e('places.label')} requerido />
    <CampoTexto idPrefijo={locale} nombre="places.titleLines" etiqueta="Título (una línea por renglón)" valor={v('places.titleLines')} error={e('places.titleLines')} tipo="area" filas={2} requerido />
    <CampoTexto idPrefijo={locale} nombre="places.lead" etiqueta="Entrada" valor={v('places.lead')} error={e('places.lead')} tipo="area" requerido />
    <CampoTexto idPrefijo={locale} nombre="places.ctaLabel" etiqueta="Texto del botón" valor={v('places.ctaLabel')} error={e('places.ctaLabel')} requerido />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">04 · El dojo</legend>
    <CampoTexto idPrefijo={locale} nombre="dojo.label" etiqueta="Rótulo" valor={v('dojo.label')} error={e('dojo.label')} requerido />
    <CampoTexto idPrefijo={locale} nombre="dojo.titleLines" etiqueta="Título (una línea por renglón)" valor={v('dojo.titleLines')} error={e('dojo.titleLines')} tipo="area" filas={2} requerido />
    <CampoImagen idPrefijo={locale} nombre="media.dojoPhoto" etiqueta="Foto de la sección" valor={medios.dojoPhoto} errores={errores} ayuda="Es la misma en los cuatro idiomas." />
    <CampoTexto idPrefijo={locale} nombre="dojo.photoCaption" etiqueta="Pie de foto" valor={v('dojo.photoCaption')} error={e('dojo.photoCaption')} requerido />
    <CampoTexto idPrefijo={locale} nombre="dojo.photoAlt" etiqueta="Texto alternativo de la foto" valor={v('dojo.photoAlt')} error={e('dojo.photoAlt')} requerido />
    <CampoTexto idPrefijo={locale} nombre="dojo.teacher.name" etiqueta="Profesor · nombre" valor={v('dojo.teacher.name')} error={e('dojo.teacher.name')} requerido />
    <CampoTexto idPrefijo={locale} nombre="dojo.teacher.credentialsLines" etiqueta="Profesor · credenciales (una por línea)" valor={v('dojo.teacher.credentialsLines')} error={e('dojo.teacher.credentialsLines')} tipo="area" filas={2} requerido />
    <CampoTexto idPrefijo={locale} nombre="dojo.teacher.bio" etiqueta="Profesor · reseña" valor={v('dojo.teacher.bio')} error={e('dojo.teacher.bio')} tipo="area" requerido />
    <CampoImagen idPrefijo={locale} nombre="media.teacherPhoto" etiqueta="Profesor · retrato" valor={medios.teacherPhoto} errores={errores} ayuda="Es la misma en los cuatro idiomas." />
    <CampoTexto idPrefijo={locale} nombre="dojo.teacher.photoAlt" etiqueta="Profesor · texto alternativo" valor={v('dojo.teacher.photoAlt')} error={e('dojo.teacher.photoAlt')} requerido />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">05 · El umbral</legend>
    <CampoTexto idPrefijo={locale} nombre="threshold.label" etiqueta="Rótulo" valor={v('threshold.label')} error={e('threshold.label')} requerido />
    <CampoTexto idPrefijo={locale} nombre="threshold.titleLines" etiqueta="Título (una línea por renglón)" valor={v('threshold.titleLines')} error={e('threshold.titleLines')} tipo="area" filas={2} requerido />
    <CampoTexto idPrefijo={locale} nombre="threshold.text" etiqueta="Texto" valor={v('threshold.text')} error={e('threshold.text')} tipo="area" requerido />
    <CampoTexto idPrefijo={locale} nombre="threshold.ctaLabel" etiqueta="Texto del botón" valor={v('threshold.ctaLabel')} error={e('threshold.ctaLabel')} requerido />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">06 · Parcerías</legend>
    <CampoTexto idPrefijo={locale} nombre="partnerships.label" etiqueta="Rótulo" valor={v('partnerships.label')} error={e('partnerships.label')} requerido />
    <CampoTexto idPrefijo={locale} nombre="partnerships.title" etiqueta="Título" valor={v('partnerships.title')} error={e('partnerships.title')} requerido />
  </fieldset>

  <button class="mt-8 bg-[#0099ff] px-6 py-3 font-semibold text-white" type="submit">
    Publicar {LOCALE_NAME[locale]}
  </button>
</form>
