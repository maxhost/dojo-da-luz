---
import { LOCALE_NAME, type Locale } from '../../lib/i18n'
import type { Archivo } from '../../lib/editor-pantalla'

/**
 * Las cuatro pestañas de idioma (spec 0036, generalizado en la 0037). Son CSS, como en el
 * editor de Home: los cuatro formularios estan en la pagina desde el principio, asi que
 * cambiar de idioma no navega y no pierde lo escrito sin guardar.
 *
 * El formulario llega como prop porque cada pagina tiene el suyo y las pestañas son
 * siempre las mismas.
 */

interface Props {
  /** El componente de formulario de esta pagina. */
  formulario: any
  /** Props extra que ese formulario necesita y estas pestañas no conocen. */
  extra?: Record<string, unknown>
  archivos: Archivo[]
  errores: Partial<Record<Locale, Record<string, string>>>
  shas: Record<Locale, string>
  activo: Locale
}

const { formulario: Formulario, extra = {}, archivos, errores, shas, activo } = Astro.props

const TABS = [
  { locale: 'pt' },
  { locale: 'es' },
  { locale: 'fr' },
  { locale: 'en' },
] as const
---

<div class="mt-7" data-pestanas-editor>
  <div class="sticky top-16 z-20 grid grid-cols-4 gap-1 rounded-lg border border-[#d7cec0] bg-[#eee9e0]/95 p-1 shadow-sm backdrop-blur lg:top-0">
    {TABS.map((tab) => (
      <div>
        <input class="sr-only" type="radio" name="idioma-activo" id={`tab-${tab.locale}`} value={tab.locale} checked={activo === tab.locale} />
        <label
          class:list={[
            'flex min-h-11 cursor-pointer items-center justify-center rounded-md px-1 text-center text-xs font-semibold transition-colors sm:px-4 sm:text-sm',
            activo === tab.locale ? 'bg-[#0099ff] text-white' : 'text-[#625c55] hover:bg-white/70',
          ]}
          for={`tab-${tab.locale}`}
          data-etiqueta-editor={tab.locale}
        >
          <span class="sm:hidden">{tab.locale.toUpperCase()}</span>
          <span class="hidden sm:inline">{LOCALE_NAME[tab.locale]}</span>
        </label>
      </div>
    ))}
  </div>

  {TABS.map((tab) => {
    const archivo = archivos.find((a) => a.locale === tab.locale)!
    return (
      <section class="pt-5" hidden={activo !== tab.locale} data-panel-editor={tab.locale} aria-label={`Contenido en ${LOCALE_NAME[tab.locale]}`}>
        <Formulario
          locale={archivo.locale}
          datos={archivo.datos}
          errores={errores[archivo.locale] ?? {}}
          shas={shas}
          sinTraducir={archivo.sinTraducir}
          {...extra}
        />
      </section>
    )
  })}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-pestanas-editor]').forEach((editor) => {
    editor.querySelectorAll<HTMLInputElement>('input[name="idioma-activo"]').forEach((control) => {
      control.addEventListener('change', () => {
        if (!control.checked) return
        editor.querySelectorAll<HTMLElement>('[data-panel-editor]').forEach((panel) => {
          panel.hidden = panel.dataset.panelEditor !== control.value
        })
        editor.querySelectorAll<HTMLElement>('[data-etiqueta-editor]').forEach((etiqueta) => {
          const seleccionada = etiqueta.dataset.etiquetaEditor === control.value
          etiqueta.classList.toggle('bg-[#0099ff]', seleccionada)
          etiqueta.classList.toggle('text-white', seleccionada)
          etiqueta.classList.toggle('text-[#625c55]', !seleccionada)
          etiqueta.classList.toggle('hover:bg-white/70', !seleccionada)
        })
      })
    })
  })
</script>
