---
import FormularioAudiencia from './FormularioAudiencia.astro'
import { LOCALE_NAME, type Locale } from '../../lib/i18n'
import type { PaginaAudiencia } from '../../lib/audiencia-edicion'
import type { Archivo } from '../../lib/audiencia-pantalla'

/**
 * Las cuatro pestañas de idioma (spec 0036). Son CSS, como en el editor de Home: los
 * cuatro formularios estan en la pagina desde el principio, asi que cambiar de idioma no
 * navega y no pierde lo escrito sin guardar.
 */

interface Props {
  pagina: PaginaAudiencia
  archivos: Archivo[]
  errores: Partial<Record<Locale, Record<string, string>>>
  shas: Record<Locale, string>
  activo: Locale
}

const { pagina, archivos, errores, shas, activo } = Astro.props

const TABS = [
  { locale: 'pt', peer: 'peer/pt', boton: 'peer-checked/pt:bg-[#0099ff] peer-checked/pt:text-white', panel: 'hidden peer-checked/pt:block' },
  { locale: 'es', peer: 'peer/es', boton: 'peer-checked/es:bg-[#0099ff] peer-checked/es:text-white', panel: 'hidden peer-checked/es:block' },
  { locale: 'fr', peer: 'peer/fr', boton: 'peer-checked/fr:bg-[#0099ff] peer-checked/fr:text-white', panel: 'hidden peer-checked/fr:block' },
  { locale: 'en', peer: 'peer/en', boton: 'peer-checked/en:bg-[#0099ff] peer-checked/en:text-white', panel: 'hidden peer-checked/en:block' },
] as const
---

<div class="mt-8">
  {TABS.map((tab) => (
    <input
      class={`${tab.peer} sr-only`}
      type="radio"
      name="idioma-activo"
      id={`tab-audiencia-${tab.locale}`}
      checked={activo === tab.locale}
    />
  ))}

  {TABS.map((tab) => (
    <label
      class={`mr-2 inline-block cursor-pointer border border-[#d7cec0] bg-white px-4 py-2 text-sm ${tab.boton}`}
      for={`tab-audiencia-${tab.locale}`}
    >
      {LOCALE_NAME[tab.locale]}
    </label>
  ))}

  {TABS.map((tab) => {
    const archivo = archivos.find((a) => a.locale === tab.locale)!
    return (
      <section class={tab.panel}>
        <FormularioAudiencia
          pagina={pagina}
          locale={archivo.locale}
          datos={archivo.datos}
          errores={errores[archivo.locale] ?? {}}
          shas={shas}
          sinTraducir={archivo.sinTraducir}
        />
      </section>
    )
  })}
</div>
