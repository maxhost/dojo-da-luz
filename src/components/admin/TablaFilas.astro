---
import CampoImagen from './CampoImagen.astro'
import { errorDe } from '../../lib/forms'

/**
 * La tablita (spec 0035). Una fila por cosa, un "quitar" por fila, un "añadir fila" abajo.
 * Es el mismo control en las cinco listas de `/aulas`: cuotas, notas, parrafos, datos de
 * crianças y preguntas frecuentes.
 *
 * **Solo la pestaña portuguesa la trae completa** (ADR-0030). En es/fr/en `editable` es
 * `false` y quedan los campos de texto sin "añadir" ni "quitar": el largo de la lista lo
 * decide el portugues, asi que algo que no existe en portugues no puede existir en ingles.
 *
 * Una columna puede ser una **imagen** (spec 0038): pinta el mismo `CampoImagen` que el
 * resto del backoffice, con la miniatura como boton. En es/fr/en va en modo solo lectura,
 * porque la foto la siembra el portugues (ADR-0032).
 */

interface Columna {
  campo: string
  etiqueta: string
  tipo?: 'texto' | 'area' | 'imagen'
}

interface Props {
  titulo: string
  prefijo: string
  columnas: Columna[]
  filas: Record<string, string>[]
  errores: Record<string, string>
  idPrefijo: string
  editable: boolean
  /** Indices cuyo texto sigue siendo el portugues. Vacio en la pestaña portuguesa. */
  sinTraducir?: number[]
  ayuda?: string
}

const { titulo, prefijo, columnas, filas, errores, idPrefijo, editable, sinTraducir = [], ayuda } =
  Astro.props

const id = (i: number | string, campo: string) =>
  `${idPrefijo}-${prefijo.replace(/\W+/g, '-')}-${i}-${campo}`

const campoClase =
  'mt-1 w-full border border-[#d7cec0] bg-white px-3 py-2 text-sm text-[#211f1c]'
---

<div class="mt-6" data-tabla data-prefijo={prefijo} data-editable={editable ? 'si' : 'no'}>
  <p class="text-sm font-semibold">{titulo}</p>
  {ayuda && <p class="mt-1 text-xs text-[#625c55]">{ayuda}</p>}

  <ol class="mt-3 list-none space-y-3 p-0" data-lista>
    {filas.map((fila, i) => (
      <li class="border border-[#d7cec0] bg-white p-3" data-fila>
        {sinTraducir.includes(i) && (
          <p class="mb-2 inline-block bg-[#fff3cd] px-2 py-1 text-xs font-semibold text-[#7a5c00]">
            Sin traducir — dice lo mismo que en portugués
          </p>
        )}

        <div class="grid gap-3 md:grid-cols-2">
          {columnas.map((columna) => columna.tipo === 'imagen' ? (
            /* No va dentro de un `label`: el control es un boton, y un boton dentro de una
               etiqueta se dispara al tocar el texto de al lado. */
            <CampoImagen
              idPrefijo={idPrefijo}
              nombre={`${prefijo}[${i}].${columna.campo}`}
              etiqueta={columna.etiqueta}
              valor={fila[columna.campo] ?? ''}
              errores={errores}
              soloLectura={!editable}
            />
          ) : (
            <label class="block text-xs font-semibold text-[#625c55]" for={id(i, columna.campo)}>
              {columna.etiqueta}
              {columna.tipo === 'area' ? (
                <textarea
                  class={campoClase}
                  id={id(i, columna.campo)}
                  name={`${prefijo}[${i}].${columna.campo}`}
                  rows="3">{fila[columna.campo] ?? ''}</textarea>
              ) : (
                <input
                  class={campoClase}
                  id={id(i, columna.campo)}
                  name={`${prefijo}[${i}].${columna.campo}`}
                  type="text"
                  value={fila[columna.campo] ?? ''}
                />
              )}
              {errorDe(errores, `${prefijo}.${i}.${columna.campo}`) && (
                <span class="mt-1 block text-xs font-semibold text-[#b3261e]" role="alert">
                  {errorDe(errores, `${prefijo}.${i}.${columna.campo}`)}
                </span>
              )}
            </label>
          ))}
        </div>

        {editable && (
          <button class="mt-2 text-xs font-semibold text-[#b3261e] underline" type="button" data-quitar>
            Quitar
          </button>
        )}
      </li>
    ))}
  </ol>

  {editable && (
    <template data-plantilla>
      <li class="border border-[#d7cec0] bg-white p-3" data-fila>
        <div class="grid gap-3 md:grid-cols-2">
          {columnas.map((columna) => columna.tipo === 'imagen' ? (
            <CampoImagen
              nombre={`${prefijo}[__i__].${columna.campo}`}
              etiqueta={columna.etiqueta}
              valor=""
              errores={{}}
            />
          ) : (
            <label class="block text-xs font-semibold text-[#625c55]">
              {columna.etiqueta}
              {columna.tipo === 'area' ? (
                <textarea class={campoClase} name={`${prefijo}[__i__].${columna.campo}`} rows="3"></textarea>
              ) : (
                <input class={campoClase} name={`${prefijo}[__i__].${columna.campo}`} type="text" />
              )}
            </label>
          ))}
        </div>
        <button class="mt-2 text-xs font-semibold text-[#b3261e] underline" type="button" data-quitar>
          Quitar
        </button>
      </li>
    </template>
  )}

  {editable && (
    <button class="mt-3 border border-[#1f1b16] bg-white px-4 py-2 text-sm font-semibold" type="button" data-anadir>
      Añadir fila
    </button>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabla]').forEach((tabla) => {
    if (tabla.dataset.editable !== 'si') return

    const lista = tabla.querySelector<HTMLOListElement>('[data-lista]')
    const plantilla = tabla.querySelector<HTMLTemplateElement>('[data-plantilla]')
    const anadir = tabla.querySelector<HTMLButtonElement>('[data-anadir]')
    if (!lista || !plantilla || !anadir) return

    // Los indices no se reusan: basta que sean distintos y crecientes para que el orden
    // del formulario sea el orden de la lista.
    let siguiente = lista.querySelectorAll('[data-fila]').length

    tabla.addEventListener('click', (evento) => {
      const objetivo = evento.target
      if (!(objetivo instanceof Element)) return
      objetivo.closest('[data-quitar]')?.closest('[data-fila]')?.remove()
    })

    anadir.addEventListener('click', () => {
      const fragmento = plantilla.content.cloneNode(true) as DocumentFragment
      fragmento.querySelectorAll<HTMLElement>('[name]').forEach((campo) => {
        const nombre = campo.getAttribute('name') ?? ''
        campo.setAttribute('name', nombre.replace('__i__', String(siguiente)))
      })
      siguiente += 1
      lista.append(fragmento)

      // El script de `CampoImagen` ya corrio cuando cargo la pagina: una fila recien creada
      // tiene que engancharse sola.
      const nueva = lista.querySelector<HTMLElement>('[data-fila]:last-child')
      nueva?.querySelectorAll<HTMLElement>('[data-campo-imagen]').forEach((campo) => {
        campo.dispatchEvent(new Event('campo-imagen:inicializar', { bubbles: true }))
      })
      nueva?.querySelector<HTMLElement>('input[type="text"], textarea')?.focus()
    })
  })
</script>
