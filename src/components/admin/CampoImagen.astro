---
import { errorDe } from '../../lib/forms'

/**
 * Una imagen se cambia tocandola (ADR-0029). La miniatura es el boton: abre el selector de
 * archivos, sube a R2 y deja la direccion en el campo que viaja con el formulario.
 *
 * La subida ocurre al elegir el archivo, no al publicar, y es deliberado: es lo que permite
 * ver la imagen definitiva antes de guardar. **El sitio no cambia hasta que se publica.**
 *
 * La URL que devuelve R2 es un detalle de implementacion: viaja oculta en el formulario y
 * nunca se le pide al usuario que la escriba.
 */

interface Props {
  nombre: string
  etiqueta: string
  valor: string
  errores: Record<string, string>
  ayuda?: string
  idPrefijo?: string
  /** Las filas de una lista de largo libre no son obligatorias: la ultima esta vacia. */
  requerido?: boolean
  /**
   * En es/fr/en la foto se ve pero no se cambia (ADR-0032): quien traduce necesita mirarla
   * para escribir la descripcion, y que no se pueda tocar es lo que sostiene la garantia
   * de que la imagen es la misma en los cuatro idiomas.
   */
  soloLectura?: boolean
  /**
   * `icono` sube una WebP de 256 px en vez de 1600: es lo que piden el logo y el favicon,
   * que se pintan a 56 y a 32 px (spec 0044).
   */
  variante?: 'foto' | 'icono'
}

const {
  nombre,
  etiqueta,
  valor,
  errores,
  ayuda,
  idPrefijo,
  requerido = true,
  soloLectura = false,
  variante = 'foto',
} = Astro.props

const id = `${idPrefijo ? `${idPrefijo}-` : ''}${nombre.replace(/[^a-zA-Z0-9]+/g, '-')}`
const error = errorDe(errores, nombre)
---

<div class="mt-5 rounded-lg border border-[#e2dbd0] bg-[#f7f3ec] p-3.5 sm:p-4" data-campo-imagen={soloLectura ? undefined : true} data-variante={variante}>
  <p class="text-sm font-semibold">
    {etiqueta}
    {requerido && <span class="text-[#b3261e]" aria-hidden="true">*</span>}
  </p>

  {ayuda && <p class="mt-1 text-xs text-[#625c55]" id={`${id}-ayuda`}>{ayuda}</p>}

  {soloLectura ? (
    <>
      <img class="mt-3 block aspect-[3/2] w-full max-w-64 rounded-md border border-[#d7cec0] bg-[#f6f1e8] object-cover" src={valor} alt="" loading="lazy" />
      <p class="mt-1 text-xs text-[#625c55]">Se cambia en la pestaña <strong>Português</strong>.</p>
      <input id={id} name={nombre} type="hidden" value={valor} />
    </>
  ) : (
  <>
  {/* La imagen es el unico control visible: tocarla abre el selector de archivos. */}
  <button
    class="group mt-3 block w-full max-w-64 cursor-pointer overflow-hidden rounded-md border border-[#c9c0b3] bg-white p-0 text-left transition hover:border-[#0099ff] focus:outline-none focus:ring-2 focus:ring-[#0099ff]/25"
    type="button"
    hidden
    aria-label={`Cambiar la imagen: ${etiqueta}`}
    data-abrir
  >
    <img class="block aspect-[3/2] w-full bg-[#f6f1e8] object-cover" src={valor} alt="" loading="lazy" data-previa />
    <span class="block bg-[#1f1b16] px-3 py-2 text-center text-xs font-semibold text-[#f6f1e8]">
      {valor ? 'Cambiar imagen' : 'Subir imagen'}
    </span>
  </button>

  <input
    class="sr-only"
    type="file"
    accept="image/jpeg,image/png,image/webp,image/avif"
    tabindex="-1"
    aria-hidden="true"
    data-archivo
  />

  <p class="mt-1 text-xs text-[#625c55]" role="status" data-estado></p>

  <input id={id} name={nombre} type="hidden" value={valor} data-url />
  </>
  )}

  {error && (
    <p class="mt-1 text-xs font-semibold text-[#b3261e]" id={`${id}-error`} role="alert">{error}</p>
  )}
</div>

<script>
  const inicializarCampoImagen = (campo: HTMLElement) => {
    if (campo.dataset.inicializado === 'si') return
    const url = campo.querySelector<HTMLInputElement>('[data-url]')
    const archivo = campo.querySelector<HTMLInputElement>('[data-archivo]')
    const abrir = campo.querySelector<HTMLButtonElement>('[data-abrir]')
    const estado = campo.querySelector<HTMLElement>('[data-estado]')
    const previa = campo.querySelector<HTMLImageElement>('[data-previa]')
    const rotulo = abrir?.querySelector('span')
    if (!url || !archivo || !abrir || !estado || !previa) return

    campo.dataset.inicializado = 'si'
    abrir.hidden = false

    let temporal = ''
    const mostrar = (valor: string) => {
      previa.src = valor
      if (rotulo) rotulo.textContent = valor ? 'Cambiar imagen' : 'Subir imagen'
    }

    abrir.addEventListener('click', () => archivo.click())
    archivo.addEventListener('change', async () => {
      const elegido = archivo.files?.[0]
      if (!elegido) return

      // Entre elegir y que R2 conteste pasan segundos: se ve la foto elegida, no un cartel.
      temporal = URL.createObjectURL(elegido)
      previa.src = temporal
      archivo.disabled = true
      abrir.disabled = true
      estado.textContent = 'Subiendo…'

      try {
        const cuerpo = new FormData()
        cuerpo.append('archivo', elegido)
        cuerpo.append('variante', campo.dataset.variante ?? 'foto')
        const res = await fetch('/admin/medios/subir', { method: 'POST', body: cuerpo })
        const datos = (await res.json()) as { url?: string; motivo?: string; reusado?: boolean }

        if (!res.ok || !datos.url) {
          estado.textContent = datos.motivo ?? `Error ${res.status}`
          mostrar(url.value)
          return
        }

        url.value = datos.url
        mostrar(datos.url)
        estado.textContent = 'Lista. No se publica hasta que guardes esta página.'
        archivo.value = ''
      } catch (error) {
        estado.textContent = `No se pudo subir: ${error instanceof Error ? error.message : error}`
        mostrar(url.value)
      } finally {
        if (temporal) URL.revokeObjectURL(temporal)
        temporal = ''
        archivo.disabled = false
        abrir.disabled = false
      }
    })
  }

  document.querySelectorAll<HTMLElement>('[data-campo-imagen]').forEach(inicializarCampoImagen)
  document.addEventListener('campo-imagen:inicializar', (evento) => {
    const campo = evento.target
    if (campo instanceof HTMLElement && campo.matches('[data-campo-imagen]')) {
      inicializarCampoImagen(campo)
    }
  })
</script>
