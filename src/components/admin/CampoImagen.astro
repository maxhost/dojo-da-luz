---
import { errorDe } from '../../lib/forms'

/**
 * Campo de imagen (specs 0029 y 0030). Tres caminos al mismo sitio: pegar una dirección,
 * subir un archivo, o copiar una de `/admin/medios`.
 *
 * La subida es una isla porque el formulario de Home es un `POST` normal de 52 campos:
 * mandarlo entero para adjuntar una foto perdería todo lo escrito sin guardar. El
 * `<input type="file">` sube aparte y solo escribe la dirección en el campo de texto.
 *
 * La vista previa importa mas de lo que parece: una URL valida que apunta a la imagen
 * equivocada pasa cualquier validacion, y el unico modo de verlo es verla.
 */

interface Props {
  nombre: string
  etiqueta: string
  valor: string
  errores: Record<string, string>
  ayuda?: string
  idPrefijo?: string
  /** Las filas de una lista de largo libre no son obligatorias: la ultima esta vacia. */
  requerido?: boolean
}

const { nombre, etiqueta, valor, errores, ayuda, idPrefijo, requerido = true } = Astro.props

const id = `${idPrefijo ? `${idPrefijo}-` : ''}${nombre.replace(/[^a-zA-Z0-9]+/g, '-')}`
const error = errorDe(errores, nombre)
---

<div class="mt-5" data-campo-imagen>
  <label class="block text-sm font-semibold" for={id}>
    {etiqueta}
    {requerido && <span class="text-[#b3261e]" aria-hidden="true">*</span>}
  </label>

  {ayuda && <p class="mt-1 text-xs text-[#625c55]" id={`${id}-ayuda`}>{ayuda}</p>}

  <div class="mt-2 flex items-start gap-4">
    <img
      class="h-20 w-28 shrink-0 border border-[#d7cec0] bg-white object-cover"
      src={valor}
      alt=""
      loading="lazy"
      hidden={!valor}
      data-previa
    />
    <div class="w-full">
      <input
        class={`w-full border bg-white px-3 py-2 text-sm ${error ? 'border-[#b3261e]' : 'border-[#d7cec0]'}`}
        id={id}
        name={nombre}
        type="url"
        value={valor}
        required={requerido}
        aria-describedby={[ayuda && `${id}-ayuda`, error && `${id}-error`].filter(Boolean).join(' ') || undefined}
        data-url
      />

      <div class="mt-2 flex flex-wrap items-center gap-3" hidden data-subida>
        <input
          class="text-xs"
          type="file"
          accept="image/jpeg,image/png,image/webp,image/avif"
          aria-label={`Subir una imagen para: ${etiqueta}`}
          data-archivo
        />
        <span class="text-xs text-[#625c55]" role="status" data-estado></span>
      </div>

      <p class="mt-1 text-xs text-[#625c55]">
        Pegá una dirección, subí un archivo, o copiá una de
        <a href="/admin/medios" target="_blank" rel="noopener">Imágenes</a>. Subir no guarda
        la página: hay que publicar igual.
      </p>
    </div>
  </div>

  {error && (
    <p class="mt-1 text-xs font-semibold text-[#b3261e]" id={`${id}-error`} role="alert">{error}</p>
  )}
</div>

<script>
  // Sin JavaScript el campo sigue sirviendo: se pega la direccion a mano y el selector de
  // archivo ni aparece, para no ofrecer un boton que no haria nada.
  document.querySelectorAll<HTMLElement>('[data-campo-imagen]').forEach((campo) => {
    const url = campo.querySelector<HTMLInputElement>('[data-url]')
    const archivo = campo.querySelector<HTMLInputElement>('[data-archivo]')
    const caja = campo.querySelector<HTMLElement>('[data-subida]')
    const estado = campo.querySelector<HTMLElement>('[data-estado]')
    const previa = campo.querySelector<HTMLImageElement>('[data-previa]')
    if (!url || !archivo || !caja || !estado || !previa) return

    caja.hidden = false

    const mostrar = (valor: string) => {
      previa.src = valor
      previa.hidden = !valor
    }

    url.addEventListener('change', () => mostrar(url.value))

    archivo.addEventListener('change', async () => {
      const elegido = archivo.files?.[0]
      if (!elegido) return

      archivo.disabled = true
      estado.textContent = 'Subiendo…'

      try {
        const cuerpo = new FormData()
        cuerpo.append('archivo', elegido)
        const res = await fetch('/admin/medios/subir', { method: 'POST', body: cuerpo })
        const datos = (await res.json()) as { url?: string; motivo?: string; reusado?: boolean }

        if (!res.ok || !datos.url) {
          estado.textContent = datos.motivo ?? `Error ${res.status}`
          return
        }

        url.value = datos.url
        mostrar(datos.url)
        estado.textContent = datos.reusado ? 'Ya estaba subida.' : 'Subida. Acordate de publicar.'
        archivo.value = ''
      } catch (error) {
        estado.textContent = `No se pudo subir: ${error instanceof Error ? error.message : error}`
      } finally {
        archivo.disabled = false
      }
    })
  })
</script>
