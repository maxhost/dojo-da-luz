---
import FilaOpcion from './FilaOpcion.astro'
import TarjetaCampo from './TarjetaCampo.astro'
import type { Campo } from '../../lib/formularios'
import type { Locale } from '../../lib/i18n'
import { AGREGAR } from '../../lib/editor-campos-estilos'

/**
 * La lista de campos de un formulario (spec 0050, 0062).
 *
 * En portugues se crea, se ordena y se borra; en los otros tres idiomas la estructura se ve
 * pero no se toca, y solo se traducen los textos (ADR-0046). La diferencia es una sola
 * variable, `editable`, porque los dos lados tienen que mostrar **lo mismo**: si el orden o
 * el tipo no se vieran al traducir, traducir seria a ciegas.
 *
 * Agregar es explicito: «+ Agregar campo» y «+ Agregar opción» instancian las dos
 * plantillas de abajo. Antes habia una tarjeta vacia siempre al final (spec 0057) y el
 * cliente no la encontraba: con nueve campos quedaba a 6000 px, parecia un campo mas y la
 * opcion vacia caia debajo de la barra de publicar.
 */

interface Props {
  campos: Campo[]
  locale: Locale
  errores: Record<string, string>
  editable: boolean
}

const { campos, locale, errores, editable } = Astro.props

const vacio: Campo = {
  id: '',
  type: 'text',
  required: false,
  label: { pt: '', es: '', fr: '', en: '' },
  help: { pt: null, es: null, fr: null, en: null },
  presentation: null,
  options: [],
}
---

<div data-editor-campos>
  {editable && (
    <div class="mt-4">
      <button class={AGREGAR} type="button" data-agregar-campo>+ Agregar campo</button>
    </div>
  )}

  <div class="mt-5 grid gap-4" data-lista-campos data-siguiente={campos.length}>
    {campos.map((campo, i) => (
      <TarjetaCampo campo={campo} i={i} locale={locale} errores={errores} editable={editable} />
    ))}
  </div>

  {editable && (
    <>
      <div class="mt-4">
        <button class={AGREGAR} type="button" data-agregar-campo>+ Agregar campo</button>
      </div>

      <p class="mt-4 text-sm leading-6 text-[#625c55]">
        Usá <strong>+ Agregar campo</strong> y <strong>+ Agregar opción</strong>. Para sacar algo ya
        publicado, tildá «Quitar». Nada se publica hasta que aprietes Publicar.
      </p>

      {/* Lo que instancia el navegador. Un <template> no se envia con el formulario. */}
      <template data-plantilla-campo>
        <TarjetaCampo campo={vacio} i="__I__" locale={locale} errores={{}} editable />
      </template>
      <template data-plantilla-opcion>
        <FilaOpcion opcion={null} i="__I__" j="__J__" locale={locale} editable />
      </template>
    </>
  )}
</div>

<script>
  import '../../lib/editor-campos-navegador.ts'
</script>
