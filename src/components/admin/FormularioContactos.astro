---
import CampoTexto from './CampoTexto.astro'
import NavegacionEditor from './NavegacionEditor.astro'
import { errorDe } from '../../lib/forms'
import { getDojos } from '../../lib/dojos'
import { LOCALES, LOCALE_NAME, type Locale } from '../../lib/i18n'

/**
 * El formulario de `/contactos` para un idioma (spec 0042). Los cuatro se pintan a la vez:
 * cambiar de pestaña es CSS, no una navegacion.
 *
 * **Los dojos no se editan aca** (ADR-0038). Se pinta un recuadro por dojo **activo** con
 * su nombre como rotulo que no se puede tocar, y dentro solo las lineas de como se llega,
 * que si se traducen. Dar de alta, archivar o renombrar una sede es la pantalla de Dojos.
 */

interface Props {
  locale: Locale
  datos: Record<string, any>
  errores: Record<string, string>
  shas: Record<Locale, string>
  /** Ruta de lista → indices sin traducir. Esta pagina no tiene listas: llega vacio. */
  sinTraducir: Record<string, number[]>
}

const { locale, datos, errores, shas } = Astro.props

const v = (ruta: string): string =>
  ruta.split('.').reduce<any>((actual, clave) => actual?.[clave], datos) ?? ''
const e = (ruta: string) => errorDe(errores, ruta)

const dojos = getDojos()
const transporte: Record<string, string[]> = datos.transport ?? {}
const lineasDe = (slug: string) => (transporte[slug] ?? []).join('\n')

/**
 * Las lineas de los dojos que ya no estan activos. No se pintan —su tarjeta no sale en la
 * pagina— pero viajan ocultas: si no, publicar una vez las borraria, y reactivar el dojo lo
 * devolveria a la pagina sin saber como se llega.
 */
const archivados = Object.keys(transporte).filter((slug) => !dojos.some((d) => d.slug === slug))

const seccion = 'scroll-mt-36 rounded-xl border border-[#d7cec0] bg-white p-4 shadow-[0_1px_2px_rgba(33,31,28,0.04)] sm:p-6 xl:col-start-2'
const navegacion = [['seo', 'SEO'], ['portada', '01 · Portada'], ['llegar', '02 · Cómo llegar'], ['particulares', '03 · Clases particulares'], ['formulario', '04 · Formulario']] as const

const campo = (nombre: string, etiqueta: string, extra: Record<string, unknown> = {}) => ({
  idPrefijo: locale,
  nombre,
  etiqueta,
  valor: v(nombre),
  error: e(nombre),
  requerido: true,
  ...extra,
})
---

<form method="post" class="grid gap-4 xl:grid-cols-[12rem_minmax(0,1fr)] xl:items-start xl:gap-x-7">
  <input type="hidden" name="idioma" value={locale} />
  {/* Los cuatro `sha`: publicar portugues toca los cuatro archivos y los verifica todos. */}
  {LOCALES.map((otro) => <input type="hidden" name={`sha.${otro}`} value={shas[otro]} />)}

  {archivados.map((slug) => (
    <textarea hidden name={`transport.${slug}`}>{lineasDe(slug)}</textarea>
  ))}

  <div class="xl:sticky xl:top-5 xl:row-span-7"><NavegacionEditor locale={locale} prefijo="contactos" titulo="Secciones de Contactos" secciones={navegacion} /></div>

  <fieldset class={seccion} id={`${locale}-contactos-seo`}><legend class="px-2 font-serif text-xl">SEO</legend>
    <CampoTexto {...campo('seo.title', 'Título de la página', { recomendado: 60, ayuda: 'Lo que se lee como titular en Google y en la pestaña del navegador.' })} />
    <CampoTexto {...campo('seo.description', 'Descripción', { tipo: 'area', recomendado: 155, ayuda: 'El párrafo que Google muestra debajo del título.' })} />
  </fieldset>

  <fieldset class={seccion} id={`${locale}-contactos-portada`}><legend class="px-2 font-serif text-xl">01 · Portada</legend>
    <CampoTexto {...campo('eyebrow', 'Antetítulo')} />
    <CampoTexto {...campo('title', 'Titular')} />
    <CampoTexto {...campo('lead', 'Bajada', { tipo: 'area' })} />
  </fieldset>

  <fieldset class={seccion} id={`${locale}-contactos-llegar`}><legend class="px-2 font-serif text-xl">02 · Cómo llegar</legend>
    <p class="text-xs text-[#625c55]">
      Un recuadro por sede abierta. <strong>Las sedes no se editan acá</strong>: se dan de
      alta, se archivan y se ordenan en <a class="underline" href="/admin/dojos">Dojos</a>,
      y esta página las toma de ahí. Acá se escribe cómo se llega a cada una, que sí se
      traduce.
    </p>

    {dojos.map((dojo) => (
      <div class="mt-5 rounded-lg border border-[#ddd5c9] bg-[#fbf8f2] p-4">
        <p class="text-sm font-semibold">
          {dojo.nombre} · <span class="font-normal text-[#625c55]">{dojo.dojo}</span>
        </p>
        <CampoTexto
          idPrefijo={locale}
          nombre={`transport.${dojo.slug}`}
          etiqueta="Cómo llegar (una línea por entrada)"
          valor={lineasDe(dojo.slug)}
          error={e(`transport.${dojo.slug}`)}
          tipo="area"
          requerido={false}
          ayuda="Metro, autobuses, referencias. Vacío: la tarjeta sale sin la lista."
        />
      </div>
    ))}

    {dojos.length === 0 && (
      <p class="mt-5 text-sm text-[#b3261e]">
        No hay ninguna sede activa. La sección de sedes no se pinta en la página.
      </p>
    )}
  </fieldset>

  <fieldset class={seccion} id={`${locale}-contactos-particulares`}><legend class="px-2 font-serif text-xl">03 · Clases particulares</legend>
    <CampoTexto {...campo('privateTitle', 'Título')} />
    <CampoTexto {...campo('privateText', 'Texto', { tipo: 'area' })} />
  </fieldset>

  <fieldset class={seccion} id={`${locale}-contactos-formulario`}><legend class="px-2 font-serif text-xl">04 · Formulario</legend>
    <CampoTexto {...campo('formTitle', 'Título')} />
    <CampoTexto {...campo('fields.name', 'Etiqueta · nombre')} />
    <CampoTexto {...campo('fields.email', 'Etiqueta · email')} />
    <CampoTexto {...campo('fields.subject', 'Etiqueta · asunto')} />
    <CampoTexto {...campo('fields.message', 'Etiqueta · mensaje')} />
    <CampoTexto {...campo('fields.submit', 'Texto del botón')} />
    <CampoTexto {...campo('fields.pending', 'Aviso debajo del botón', { tipo: 'area', ayuda: 'El formulario todavía no envía: falta configurar el email del dojo. Esta línea es lo que explica por qué el botón está apagado.' })} />
  </fieldset>

  <div class="sticky bottom-3 z-10 rounded-xl border border-[#d7cec0] bg-[#fbf8f2]/95 p-3 shadow-[0_8px_30px_rgba(33,31,28,0.16)] backdrop-blur xl:col-start-2 xl:flex xl:items-center xl:justify-between">
    <p class="mb-2 text-xs text-[#625c55] xl:mb-0">Los cambios afectan solamente a este idioma.</p>
    <button class="min-h-12 w-full rounded-md bg-[#0099ff] px-6 font-semibold text-white hover:bg-[#0077c7] xl:w-auto" type="submit">Publicar Contactos en {LOCALE_NAME[locale]}</button>
  </div>
</form>
