---
import CampoTexto from './CampoTexto.astro'
import EditorCamposFormulario from './EditorCamposFormulario.astro'
import NavegacionEditor from './NavegacionEditor.astro'
import { errorDe } from '../../lib/forms'
import { LOCALE_NAME, type Locale } from '../../lib/i18n'
import type { Formulario } from '../../lib/formularios'

/**
 * El editor de **un** formulario en **un** idioma (spec 0050). Los cuatro se pintan a la
 * vez, como en los editores de pagina: cambiar de pestaña es CSS y no pierde lo escrito.
 *
 * En portugues se decide todo: nombre, estado, campos, tipos, orden y opciones. En los
 * otros tres solo se traduce (ADR-0046) — la estructura se ve, pero no se toca.
 */

interface Props {
  locale: Locale
  formulario: Formulario
  errores: Record<string, string>
  sha: string
  /** Un formulario que todavia no existe: solo tiene pestaña portuguesa. */
  nuevo?: boolean
}

const { locale, formulario, errores, sha, nuevo = false } = Astro.props

const esPortugues = locale === 'pt'
const e = (ruta: string) => errorDe(errores, ruta)

const seccion =
  'scroll-mt-36 rounded-xl border border-[#d7cec0] bg-white p-4 shadow-[0_1px_2px_rgba(33,31,28,0.04)] sm:p-6 xl:col-start-2'
const navegacion = [
  ['ficha', '01 · La ficha'],
  ['campos', '02 · Los campos'],
  ['envio', '03 · Botón y confirmación'],
] as const
---

<form method="post" class="grid gap-4 xl:grid-cols-[12rem_minmax(0,1fr)] xl:items-start xl:gap-x-7">
  <input type="hidden" name="idioma" value={locale} />
  <input type="hidden" name="sha" value={sha} />

  {!esPortugues && (
    <p class="rounded-lg border border-[#0099ff]/30 bg-[#eaf6ff] p-4 text-sm leading-6 text-[#211f1c] xl:col-span-2">
      Acá se traduce. Para agregar, quitar o reordenar campos y opciones, o para cambiar un
      tipo, andá a la pestaña <strong>Português</strong>: la estructura es la misma en los
      cuatro idiomas.
    </p>
  )}

  <div class="xl:sticky xl:top-5 xl:row-span-4">
    <NavegacionEditor locale={locale} prefijo="formulario" titulo="Secciones del formulario" secciones={navegacion} />
  </div>

  <fieldset class={seccion} id={`${locale}-formulario-ficha`}>
    <legend class="px-2 font-serif text-xl">01 · La ficha</legend>

    {esPortugues ? (
      <>
        <CampoTexto
          idPrefijo={locale}
          nombre="nombre"
          etiqueta="Nombre del formulario"
          valor={formulario.nombre}
          error={e('nombre')}
          ayuda="Solo se ve acá adentro: es como lo vas a elegir desde una página. Cambiarlo no rompe nada."
          requerido
        />

        <div class="mt-5">
          <label class="block text-sm font-semibold" for={`${locale}-estado`}>Estado</label>
          <select
            class="mt-2 min-h-11 w-full rounded-md border border-[#c9c0b3] bg-white px-3.5 py-2.5 text-base leading-6 outline-none transition hover:border-[#9f968a] focus:border-[#0099ff] focus:ring-2 focus:ring-[#0099ff]/20 sm:text-sm"
            id={`${locale}-estado`}
            name="estado"
          >
            <option value="activo" selected={formulario.estado === 'activo'}>Activo</option>
            <option value="archivado" selected={formulario.estado === 'archivado'}>Archivado</option>
          </select>
          <p class="mt-2 text-xs leading-5 text-[#625c55]">
            Archivado quiere decir que no se puede elegir en una página nueva. Las páginas
            que ya lo usan lo siguen mostrando.
          </p>
        </div>
      </>
    ) : (
      <p class="text-sm leading-6 text-[#625c55]">
        <strong>{formulario.nombre}</strong> · {formulario.estado}
        <span class="block">El nombre y el estado se cambian en la pestaña <strong>Português</strong>.</span>
      </p>
    )}
  </fieldset>

  <fieldset class={seccion} id={`${locale}-formulario-campos`}>
    <legend class="px-2 font-serif text-xl">02 · Los campos</legend>
    <p class="text-xs leading-5 text-[#625c55]">
      {esPortugues
        ? 'Las flechas cambian el orden en el que se ven en la página. El orden se guarda al publicar.'
        : 'Traducí la etiqueta, la ayuda y las opciones. El orden y el tipo vienen del portugués.'}
    </p>

    <EditorCamposFormulario campos={formulario.fields} locale={locale} errores={errores} editable={esPortugues} />

    {e('fields') && <p class="mt-3 text-sm font-semibold text-[#b3261e]">{e('fields')}</p>}
  </fieldset>

  <fieldset class={seccion} id={`${locale}-formulario-envio`}>
    <legend class="px-2 font-serif text-xl">03 · Botón y confirmación</legend>
    <CampoTexto
      idPrefijo={locale}
      nombre="submitLabel"
      etiqueta="Texto del botón de enviar"
      valor={formulario.submitLabel[locale]}
      error={e('submitLabel')}
      requerido
    />
    <CampoTexto
      idPrefijo={locale}
      nombre="successMessage"
      etiqueta="Mensaje después de enviar"
      valor={formulario.successMessage[locale]}
      error={e('successMessage')}
      tipo="area"
      ayuda="Lo que lee la persona cuando el envío sale bien. Reemplaza al formulario en la pantalla."
      requerido
    />
  </fieldset>

  <div class="sticky bottom-3 z-10 rounded-xl border border-[#d7cec0] bg-[#fbf8f2]/95 p-3 shadow-[0_8px_30px_rgba(33,31,28,0.16)] backdrop-blur xl:col-start-2 xl:flex xl:items-center xl:justify-between">
    <p class="mb-2 text-xs text-[#625c55] xl:mb-0">
      {esPortugues
        ? 'Los campos nuevos aparecen en los cuatro idiomas con el texto portugués, para traducir.'
        : 'Los cambios afectan solamente a este idioma.'}
    </p>
    <button class="min-h-12 w-full rounded-md bg-[#0099ff] px-6 font-semibold text-white hover:bg-[#0077c7] xl:w-auto" type="submit">
      {nuevo ? 'Crear el formulario' : `Publicar en ${LOCALE_NAME[locale]}`}
    </button>
  </div>
</form>
