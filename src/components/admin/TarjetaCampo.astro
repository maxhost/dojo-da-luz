---
import FilaOpcion from './FilaOpcion.astro'
import { PRESENTACIONES, TIPOS, esSeleccion, type Campo, type Tipo } from '../../lib/formularios'
import { errorDe } from '../../lib/forms'
import type { Locale } from '../../lib/i18n'
import { AGREGAR, CONTROL, DESCARTAR, FLECHA } from '../../lib/editor-campos-estilos'

/**
 * Un campo del formulario (spec 0050, 0062). Con `campo.id` vacío es uno nuevo: lo pinta la
 * plantilla del editor con el índice `__I__`, que el navegador reemplaza al agregarlo.
 */

interface Props {
  campo: Campo
  i: number | string
  locale: Locale
  errores: Record<string, string>
  editable: boolean
}

const { campo, i, locale, errores, editable } = Astro.props

const ETIQUETA_TIPO: Record<Tipo, string> = {
  text: 'Texto corto',
  textarea: 'Texto largo',
  email: 'E-mail',
  tel: 'Teléfono',
  number: 'Número',
  date: 'Fecha',
  singleChoice: 'Elegir una opción',
  multipleChoice: 'Elegir varias opciones',
}

const ETIQUETA_PRESENTACION: Record<string, string> = {
  radio: 'Botones (se ven todas)',
  select: 'Lista desplegable',
  checkbox: 'Casillas (se ven todas)',
  multiSelect: 'Lista desplegable múltiple',
}

const PRESENTACIONES_TODAS = [...PRESENTACIONES.singleChoice, ...PRESENTACIONES.multipleChoice]

const nuevo = campo.id === ''
const seleccion = esSeleccion(campo.type)
const sinTraducir = !editable && campo.label[locale] === campo.label.pt
const numero = typeof i === 'number' ? i + 1 : null
const nombre = (dato: string) => `fields[${i}].${dato}`
const e = (ruta: string) => errorDe(errores, ruta)
---

<article class="rounded-xl border border-[#d7cec0] bg-[#fbf8f2] p-4 sm:p-5" data-campo-fila data-indice={i}>
  <div class="flex flex-wrap items-center gap-2">
    <span class="rounded-md bg-[#eee9df] px-2 py-1 text-xs font-bold text-[#625c55]" data-numero>
      {nuevo ? 'Nuevo' : `Campo ${numero}`}
    </span>
    {!editable && (
      <span class="text-xs text-[#625c55]">
        {ETIQUETA_TIPO[campo.type]}
        {campo.required ? ' · obligatorio' : ' · opcional'}
      </span>
    )}
    {sinTraducir && (
      <span class="rounded-md bg-[#fdf1d6] px-2 py-1 text-xs font-bold text-[#8a6100]">Sin traducir</span>
    )}

    {editable && (
      <div class="ml-auto flex gap-1">
        <button class={FLECHA} type="button" data-mover="arriba" aria-label="Subir el campo">↑</button>
        <button class={FLECHA} type="button" data-mover="abajo" aria-label="Bajar el campo">↓</button>
        {nuevo && <button class={DESCARTAR} type="button" data-descartar aria-label="Descartar el campo nuevo">✕</button>}
      </div>
    )}
  </div>

  <input type="hidden" name={nombre('id')} value={campo.id} />
  <input type="hidden" name={nombre('orden')} value={i} data-orden />

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <label class="block text-sm font-semibold sm:col-span-2">
      Pregunta o etiqueta
      <input class={CONTROL} name={nombre('label')} value={campo.label[locale] ?? ''} />
    </label>

    <label class="block text-sm font-semibold sm:col-span-2">
      Ayuda debajo del campo <span class="font-normal text-[#625c55]">(opcional)</span>
      <input class={CONTROL} name={nombre('help')} value={campo.help[locale] ?? ''} />
    </label>

    {editable ? (
      <>
        <label class="block text-sm font-semibold">
          Tipo de respuesta
          <select class={CONTROL} name={nombre('type')} data-tipo>
            {TIPOS.map((tipo) => (
              <option value={tipo} selected={tipo === campo.type}>{ETIQUETA_TIPO[tipo]}</option>
            ))}
          </select>
        </label>

        <div class="flex items-end gap-5 pb-1">
          <label class="flex min-h-11 items-center gap-2 text-sm font-semibold">
            <input class="size-5" type="checkbox" name={nombre('required')} value="si" checked={campo.required} />
            Obligatorio
          </label>
          {!nuevo && (
            <label class="flex min-h-11 items-center gap-2 text-sm font-semibold text-[#b3261e]">
              <input class="size-5" type="checkbox" name={nombre('quitar')} value="si" />
              Quitar
            </label>
          )}
        </div>
      </>
    ) : (
      <input type="hidden" name={nombre('type')} value={campo.type} />
    )}
  </div>

  <div class="mt-4" data-opciones hidden={!seleccion}>
    {editable && (
      <label class="block text-sm font-semibold">
        Cómo se ven las opciones
        <select class={CONTROL} name={nombre('presentation')} data-presentacion>
          {PRESENTACIONES_TODAS.map((p) => (
            <option
              value={p}
              selected={p === campo.presentation}
              data-para={PRESENTACIONES.singleChoice.includes(p) ? 'singleChoice' : 'multipleChoice'}
            >
              {ETIQUETA_PRESENTACION[p]}
            </option>
          ))}
        </select>
      </label>
    )}

    <p class="mt-4 text-sm font-semibold">Opciones</p>
    <div class="mt-2 grid gap-2" data-lista-opciones data-siguiente={campo.options.length}>
      {campo.options.map((opcion, j) => (
        <FilaOpcion opcion={opcion} i={i} j={j} locale={locale} editable={editable} />
      ))}
    </div>
    {editable && (
      <button class={`${AGREGAR} mt-3`} type="button" data-agregar-opcion>+ Agregar opción</button>
    )}
  </div>

  {(e(`fields.${i}`) || e(`fields.${i}.label`)) && (
    <p class="mt-3 text-sm font-semibold text-[#b3261e]">{e(`fields.${i}.label`) ?? e(`fields.${i}`)}</p>
  )}
</article>
