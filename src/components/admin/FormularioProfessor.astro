---
import CampoImagen from './CampoImagen.astro'
import CampoTexto from './CampoTexto.astro'
import TablaFilas from './TablaFilas.astro'
import { errorDe } from '../../lib/forms'
import { LOCALES, LOCALE_NAME, type Locale } from '../../lib/i18n'

/**
 * El formulario de `/professor-pablo-duran` para un idioma (spec 0043). Los cuatro se
 * pintan a la vez: cambiar de pestaña es CSS, no una navegacion.
 *
 * El orden de los bloques es el orden de la pagina publica. Dos cosas solo pasan en
 * portugues: añadir o quitar filas de cualquiera de las cinco listas (ADR-0030) y cambiar
 * la foto (ADR-0032).
 *
 * **Percurso (03) es el motivo de la spec**: era una lista de seis hitos escritos en el
 * JSON y ahora se arma desde la pantalla.
 */

interface Props {
  locale: Locale
  datos: Record<string, any>
  errores: Record<string, string>
  shas: Record<Locale, string>
  /** Ruta de lista → indices cuyo texto sigue siendo el portugues. */
  sinTraducir: Record<string, number[]>
}

const { locale, datos, errores, shas, sinTraducir } = Astro.props

const esPortugues = locale === 'pt'

const v = (ruta: string): string =>
  ruta.split('.').reduce<any>((actual, clave) => actual?.[clave], datos) ?? ''
const lista = (ruta: string): any[] =>
  ruta.split('.').reduce<any>((actual, clave) => actual?.[clave], datos) ?? []
const e = (ruta: string) => errorDe(errores, ruta)

/** Las tablas de una columna guardan textos sueltos: la fila es `{ valor }`. */
const textos = (ruta: string) => lista(ruta).map((valor: string) => ({ valor }))

const seccion = 'mt-8 border border-[#d7cec0] bg-[#fbf8f2] p-4'

const campo = (nombre: string, etiqueta: string, extra: Record<string, unknown> = {}) => ({
  idPrefijo: locale,
  nombre,
  etiqueta,
  valor: v(nombre),
  error: e(nombre),
  requerido: true,
  ...extra,
})

/** Los párrafos de las tres secciones de texto: la misma tabla, tres veces. */
const parrafos = (ruta: string) => ({
  titulo: 'Párrafos',
  prefijo: ruta,
  columnas: [{ campo: 'valor', etiqueta: 'Párrafo', tipo: 'area' as const }],
  filas: textos(ruta),
  errores,
  idPrefijo: locale,
  editable: esPortugues,
  sinTraducir: sinTraducir[ruta] ?? [],
})
---

<form method="post">
  <input type="hidden" name="idioma" value={locale} />
  {/* Los cuatro `sha`: publicar portugues toca los cuatro archivos y los verifica todos. */}
  {LOCALES.map((otro) => <input type="hidden" name={`sha.${otro}`} value={shas[otro]} />)}

  {!esPortugues && (
    <p class="mt-6 border-l-4 border-[#0099ff] bg-[#eaf6ff] p-3 text-sm text-[#211f1c]">
      Acá se traduce. Para añadir o quitar un hito del percurso, un párrafo o una caja del
      linaje, o para cambiar la foto, andá a la pestaña <strong>Português</strong>: lo que
      hagas ahí aparece en los cuatro idiomas.
    </p>
  )}

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">Cabecera y pie</legend>
    <CampoTexto {...campo('chrome.caption', 'Bajada del logo')} />
    <CampoTexto {...campo('chrome.menuLabel', 'Botón de menú')} />
    <CampoTexto {...campo('chrome.skipLink', 'Saltar al contenido')} />

    <p class="mt-6 text-xs text-[#625c55]">
      El menú de arriba no se edita desde acá: sus ocho enlaces son las páginas del sitio y
      se llaman igual en todas. El pie sí.
    </p>

    <CampoTexto {...campo('chrome.footerNote.areas', 'Pie · zonas')} />
    <CampoTexto {...campo('chrome.footerNote.orgType', 'Pie · tipo de organización')} />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">SEO</legend>
    <CampoTexto {...campo('seo.title', 'Título de la página', { recomendado: 60, ayuda: 'Lo que se lee como titular en Google y en la pestaña del navegador.' })} />
    <CampoTexto {...campo('seo.description', 'Descripción', { tipo: 'area', recomendado: 155, ayuda: 'El párrafo que Google muestra debajo del título.' })} />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">01 · Portada</legend>
    <CampoTexto {...campo('eyebrow', 'Antetítulo')} />
    <CampoTexto {...campo('title', 'Titular')} />
    <CampoTexto {...campo('credentials', 'Títulos', { ayuda: 'La línea azul debajo del nombre.' })} />
    <CampoTexto {...campo('lead', 'Bajada', { tipo: 'area' })} />
    <CampoImagen
      idPrefijo={locale}
      nombre="photo"
      etiqueta="Foto"
      valor={v('photo')}
      errores={errores}
      soloLectura={!esPortugues}
      ayuda="El retrato de la portada. Es la única foto de la página y es la misma en los cuatro idiomas."
    />
    <CampoTexto {...campo('photoAlt', 'Descripción de la foto', { ayuda: 'La leen los lectores de pantalla y Google.' })} />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">02 · Biografía</legend>
    <CampoTexto {...campo('biographyTitle', 'Título')} />
    <TablaFilas {...parrafos('biography')} />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">03 · Percurso</legend>
    <CampoTexto {...campo('milestonesTitle', 'Título')} />

    <TablaFilas
      titulo="Hitos"
      prefijo="milestones"
      columnas={[
        { campo: 'year', etiqueta: 'Año' },
        { campo: 'title', etiqueta: 'Título' },
        { campo: 'text', etiqueta: 'Texto', tipo: 'area' },
      ]}
      filas={lista('milestones')}
      errores={errores}
      idPrefijo={locale}
      editable={esPortugues}
      sinTraducir={sinTraducir['milestones'] ?? []}
      ayuda="Sin límite: los que haya se acomodan solos, de a dos por fila. El año es texto libre, así que puede ser «2013» o «2009–2015»."
    />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">04 · Formación contínua</legend>
    <CampoTexto {...campo('formationTitle', 'Título')} />
    <TablaFilas {...parrafos('formation')} />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">05 · Ensinar diferentes públicos</legend>
    <CampoTexto {...campo('teachingTitle', 'Título')} />
    <TablaFilas {...parrafos('teaching')} />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">06 · Línea de transmisión</legend>
    <CampoTexto {...campo('lineageTitle', 'Título')} />
    <CampoTexto {...campo('lineageIntro', 'Introducción', { tipo: 'area' })} />

    <TablaFilas
      titulo="Cajas"
      prefijo="lineage"
      columnas={[
        { campo: 'name', etiqueta: 'Nombre' },
        { campo: 'role', etiqueta: 'Rol' },
        { campo: 'text', etiqueta: 'Texto', tipo: 'area' },
      ]}
      filas={lista('lineage')}
      errores={errores}
      idPrefijo={locale}
      editable={esPortugues}
      sinTraducir={sinTraducir['lineage'] ?? []}
      ayuda="Se acomodan de a tres por fila."
    />
  </fieldset>

  <fieldset class={seccion}>
    <legend class="px-2 text-sm font-semibold">07 · Cierre hacia el dojo</legend>
    <CampoTexto {...campo('dojoCta.title', 'Título')} />
    <CampoTexto {...campo('dojoCta.text', 'Texto', { tipo: 'area' })} />
    <CampoTexto {...campo('dojoCta.label', 'Texto del botón', { ayuda: 'Lleva a la página del dojo. A dónde va no se edita: es una página del sitio.' })} />
  </fieldset>

  <button class="mt-8 bg-[#0099ff] px-6 py-3 font-semibold text-white" type="submit">
    Publicar Professor en {LOCALE_NAME[locale]}
  </button>
  {esPortugues && (
    <p class="mt-2 text-xs text-[#625c55]">
      Publicar portugués también actualiza la estructura y la foto de los otros tres
      idiomas.
    </p>
  )}
</form>
