---
import Base from '../layouts/Base.astro'
import FormModal from './FormModal.astro'
import { getContent } from '../lib/content'
import { formatAudiencia, formatHorario, getDojos } from '../lib/dojos'
import { pathFor, siteNav, type Locale } from '../lib/i18n'
import { getMedia } from '../lib/media'
import { getPartners } from '../lib/partners'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const c = getContent('home', locale)

// Las fotos y el video de la portada son contenido, no constantes: se editan desde el BO
// (ADR-0026, spec 0047). Vacio es un estado valido: la portada se ve solo con el poster.
const medios = getMedia()
const partners = getPartners()
const dojos = getDojos()
// Dos tarjetas piden dos columnas; tres, tres. Ambas clases existen literales para Tailwind.
const columnas = dojos.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'
const classesPath = pathFor('classes', locale)
const adultsPath = pathFor('adults', locale)
const childrenPath = pathFor('children', locale)
const nav = siteNav(locale)
const cerrarFormulario = { pt: 'Fechar formulário', es: 'Cerrar formulario', fr: 'Fermer le formulaire', en: 'Close form' }[locale]
---

<Base
  page="home"
  locale={locale}
  title={c.seo.title}
  description={c.seo.description}
  nav={nav}
>
  <section class="hero-traditional relative isolate flex min-h-[36rem] items-center overflow-hidden bg-[#292522] md:min-h-[43rem]">
    {medios.heroVideo ? (
      <video
        aria-hidden="true"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={medios.heroPoster}
      >
        <source src={medios.heroVideo} type="video/mp4" />
      </video>
    ) : (
      <img
        aria-hidden="true"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
        src={medios.heroPoster}
        alt=""
        loading="eager"
      />
    )}
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/60"></div>
    <div class="site-shell w-full py-24 text-center text-white md:py-32">
      <p class="text-sm font-bold uppercase tracking-[.2em] text-acento-tenue">
        {c.hero.eyebrowLines.join(' · ')}
      </p>
      <h1 class="mx-auto mt-5 max-w-[13ch] font-serif text-5xl font-normal leading-[1.02] md:text-7xl">
        {c.hero.titleLines.join(' ')} <span class="text-acento-claro">{c.hero.titleHighlight}</span>
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-white/90 md:text-xl">{c.hero.tagline}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a class="button button-primary" href={classesPath}>{c.places.ctaLabel}</a>
        <a class="button button-light" href="#umbral">{c.threshold.ctaLabel}</a>
      </div>
    </div>
  </section>

  <section id="montanha" class="section-pad bg-[#f6f1e8]">
    <div class="site-shell grid items-start gap-10 md:grid-cols-[.8fr_1.2fr] md:gap-20">
      <div>
        <p class="section-kicker">{c.practice.label}</p>
        <h2 class="section-title mt-4">{c.practice.titleLines.join(' ')}</h2>
      </div>
      <div class="border-l-2 border-acento pl-6 md:pl-9">
        {c.practice.paragraphs.map((paragraph) => (
          <p class="mt-5 text-lg leading-8 text-[#4c4741] first:mt-0">{paragraph}</p>
        ))}

        {/* Capa factual del ADR-0018: frases autocontenidas que un motor puede citar.
            Visible, no oculta: estos motores puntuan lo que el usuario ve. */}
        <div class="mt-9 border-t border-[#d7cec0] pt-7">
          {c.resumen.map((frase) => (
            <p class="mt-3 text-base leading-7 text-[#625c55] first:mt-0">{frase}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="aulas" class="section-pad bg-[#27231f] text-white">
    <div class="site-shell">
      <div class="max-w-3xl">
        <p class="section-kicker text-acento-claro">{c.audiences.label}</p>
        <h2 class="section-title mt-4 text-white">{c.audiences.title}</h2>
        <p class="mt-5 text-lg leading-8 text-white/75">{c.audiences.intro}</p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {[
          { card: c.audiences.adults, foto: medios.adultsPhoto, href: adultsPath, label: c.audiences.adultsLabel },
          { card: c.audiences.children, foto: medios.childrenPhoto, href: childrenPath, label: c.audiences.childrenLabel },
        ].map((audience) => (
          <article class="group overflow-hidden border border-white/20 bg-[#332e29]">
            <a class="block text-white no-underline" href={audience.href}>
              <img
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                src={audience.foto}
                alt={audience.card.photoAlt}
                loading="lazy"
              />
              <div class="p-7 md:p-9">
                <p class="text-xs font-bold uppercase tracking-[.18em] text-acento-claro">{audience.label}</p>
                <h3 class="mt-4 font-serif text-3xl font-normal md:text-4xl">{audience.card.title}</h3>
                <p class="mt-4 leading-7 text-white/75">{audience.card.lead}</p>
                <span class="mt-7 inline-flex items-center gap-3 font-bold text-acento-claro">
                  {c.audiences.ctaLabel}<span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="terra" class="section-pad bg-white">
    <div class="site-shell">
      <div class="max-w-3xl">
        <p class="section-kicker">{c.places.label}</p>
        <h2 class="section-title mt-4">{c.places.titleLines.join(' ')}</h2>
        <p class="mt-5 text-lg leading-8 text-[#625c55]">{c.places.lead}</p>
      </div>

      <div class:list={['mt-12 grid gap-6', columnas]}>
        {dojos.map((dojo, index) => (
          <article class="border border-[#d7cec0] bg-[#fbf8f2] p-7 md:p-9">
            <p class="text-xs font-bold uppercase tracking-[.18em] text-acento">0{index + 1}</p>
            <h3 class="mt-4 font-serif text-3xl font-normal text-[#211f1c]">{dojo.nombre}</h3>
            <p class="mt-2 font-semibold text-[#625c55]">{dojo.dojo}</p>
            {dojo.instalacion && (
              <p class="mt-1 text-sm leading-6 text-[#756e66]">{dojo.instalacion}</p>
            )}
            {dojo.direccion.calle && (
              <p class="mt-1 text-sm leading-6 text-[#756e66]">{dojo.direccion.calle}</p>
            )}
            <div class="mt-7 border-t border-[#d7cec0] pt-5">
              <p class="text-xs font-bold uppercase tracking-[.16em] text-[#756e66]">{c.places.ctaLabel}</p>
              <ul class="mt-3 list-none space-y-3 p-0">
                {dojo.horarios.map((horario) => (
                  <li>
                    <span class="block font-semibold text-[#211f1c]">{formatAudiencia(horario, locale)}</span>
                    <span class="block text-[#625c55]">{formatHorario(horario, locale)}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="dojo" class="section-pad bg-[#27231f] text-white">
    <div class="site-shell grid gap-12 md:grid-cols-2 md:items-center md:gap-20">
      <figure class="m-0">
        <img class="aspect-[4/3] w-full object-cover" src={medios.dojoPhoto} alt={c.dojo.photoAlt} loading="lazy" />
        <figcaption class="mt-3 text-sm text-white/60">{c.dojo.photoCaption}</figcaption>
      </figure>
      <div>
        <p class="section-kicker text-acento-claro">{c.dojo.label}</p>
        <h2 class="section-title mt-4 text-white">{c.dojo.titleLines.join(' ')}</h2>
        <div class="mt-9 grid grid-cols-[6rem_1fr] gap-5 border-t border-white/20 pt-7">
          <img class="aspect-[3/4] w-24 object-cover" src={medios.teacherPhoto} alt={c.dojo.teacher.photoAlt} loading="lazy" />
          <div>
            <h3 class="font-serif text-2xl">{c.dojo.teacher.name}</h3>
            <p class="mt-2 text-sm font-bold uppercase leading-6 tracking-[.1em] text-acento-claro">
              {c.dojo.teacher.credentialsLines.join(' · ')}
            </p>
            <p class="mt-3 leading-7 text-white/75">{c.dojo.teacher.bio}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="umbral" class="section-pad bg-acento text-center text-white">
    <div class="site-shell">
      <p class="section-kicker text-acento-tenue">{c.threshold.label}</p>
      <h2 class="mx-auto mt-4 max-w-3xl font-serif text-4xl font-normal leading-tight md:text-6xl">
        {c.threshold.titleLines.join(' ')}
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-white/85">{c.threshold.text}</p>
      <div class="mt-9">
        <FormModal
          id={`home-contact-${locale}`}
          title={c.threshold.titleLines.join(' ')}
          trigger={c.threshold.ctaLabel}
          closeLabel={cerrarFormulario}
          locale={locale}
          formId={c.threshold.formId}
        />
      </div>
    </div>
  </section>

  {partners.length > 0 && (
  <section id="parcerias" class="section-pad bg-[#f6f1e8]">
    <div class="site-shell">
      <div class="text-center">
        <p class="section-kicker">{c.partnerships.label}</p>
        <h2 class="section-title mt-4">{c.partnerships.title}</h2>
      </div>
      <ul class="mx-auto mt-12 grid max-w-5xl list-none grid-cols-2 gap-x-8 gap-y-10 p-0 sm:grid-cols-3 md:grid-cols-5">
        {partners.map((partner) => (
        <li class="grid h-20 place-items-center overflow-hidden">
          <img
            class="max-h-20 w-full object-contain mix-blend-multiply"
            style={partner.escala ? `transform: scale(${partner.escala})` : undefined}
            src={partner.src}
            alt={partner.nombre}
            loading="lazy"
          />
        </li>
        ))}
      </ul>
    </div>
  </section>
  )}

</Base>
