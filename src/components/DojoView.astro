---
import Base from '../layouts/Base.astro'; import { getContent } from '../lib/content'; import { pathFor, siteNav, type Locale } from '../lib/i18n'
interface Props { locale: Locale } const { locale }=Astro.props; const c=getContent('dojo',locale)
const ui={pt:['Aikido · Lisboa','Menu','Saltar para o conteúdo','Associação sem fins lucrativos'],es:['Aikido · Lisboa','Menú','Saltar al contenido','Asociación sin fines de lucro'],fr:['Aïkido · Lisbonne','Menu','Aller au contenu','Association à but non lucratif'],en:['Aikido · Lisbon','Menu','Skip to content','Non-profit association']}[locale]
const DOJO='https://static.wixstatic.com/media/ae7240_de66207c487b4e8086d18ed67c88ea93~mv2.jpg/v1/fill/w_1400,h_1000,al_c,q_85/IMG_3502_JPG.jpg'; const TEACHER='https://static.wixstatic.com/media/ae7240_4681e435c4ab47dbb9f6db8fe35fa6a5.jpg/v1/fill/w_900,h_1200,al_c,q_85/ae7240_4681e435c4ab47dbb9f6db8fe35fa6a5.jpg'
---
<Base page="dojo" locale={locale} title={c.seo.title} description={c.seo.description} skipLink={ui[2]} nav={siteNav(locale)} menuLabel={ui[1]} caption={ui[0]}>
<section class="section-pad bg-[#f6f1e8]"><div class="site-shell grid gap-12 md:grid-cols-2 md:items-center md:gap-20"><div><p class="section-kicker">{c.eyebrow}</p><h1 class="section-title mt-4 text-5xl md:text-7xl">{c.title}</h1><p class="mt-6 text-xl leading-9 text-[#625c55]">{c.lead}</p></div><img src={DOJO} alt="Dojo da Luz" class="aspect-[4/3] w-full object-cover" /></div></section>
<section class="section-pad bg-white"><div class="site-shell grid gap-10 md:grid-cols-[.7fr_1.3fr] md:gap-20"><h2 class="section-title">{c.spaceTitle}</h2><div>{c.spaceParagraphs.map(p=><p class="mt-5 text-lg leading-8 text-[#4c4741] first:mt-0">{p}</p>)}</div></div></section>
<section id="pablo-duran" class="section-pad bg-[#27231f] text-white"><div class="site-shell grid gap-12 md:grid-cols-[.55fr_1fr] md:gap-20"><img src={TEACHER} alt={c.teacher.name} class="max-h-[42rem] w-full object-cover" /><div><p class="section-kicker text-[#efb49b]">{c.teacher.label}</p><h2 class="mt-4 font-serif text-5xl">{c.teacher.name}</h2><p class="mt-4 text-sm font-bold uppercase tracking-[.12em] text-[#efb49b]">{c.teacher.credentials}</p>{c.teacher.paragraphs.map(p=><p class="mt-5 text-lg leading-8 text-white/75">{p}</p>)}<a class="button mt-8 bg-white text-[#752219]" href={pathFor('teacher',locale)}>{c.teacher.linkLabel}</a></div></div></section>
<section class="section-pad bg-[#f6f1e8]"><div class="site-shell"><h2 class="section-title">{c.lineageTitle}</h2><div class="mt-10 grid gap-6 md:grid-cols-3">{c.lineage.map(item=><article class="border border-[#d7cec0] bg-white p-7"><h3 class="font-serif text-2xl">{item.name}</h3><p class="mt-2 text-xs font-bold uppercase tracking-[.12em] text-[#9b3025]">{item.role}</p><p class="mt-5 leading-7 text-[#625c55]">{item.text}</p></article>)}</div></div></section>
<p slot="footer-note" class="text-sm text-white/65">Benfica · Lumiar · Encarnação<br />{ui[3]}</p></Base>
