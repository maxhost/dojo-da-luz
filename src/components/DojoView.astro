---
import Base from '../layouts/Base.astro'; import { getContent } from '../lib/content'; import { pathFor, siteNav, type Locale } from '../lib/i18n'
interface Props { locale: Locale } const { locale }=Astro.props; const c=getContent('dojo',locale)
/**
 * Los cinco textos del borde, las dos fotos grandes y **el equipo docente** estaban
 * escritos aca adentro (spec 0038): un array `ui` por idioma, dos constantes de Wix y un
 * objeto `additionalTeachers` con los cuatro idiomas a mano. Ahora todo sale del contenido.
 */
const chrome = c.chrome
const leadTeacher = { ...c.teacher, id: 'pablo-duran', href: pathFor('teacher', locale) }
/** El ancla de cada ficha: el nombre en minuscula, como antes. */
const anclaDe = (nombre: string) => nombre.toLowerCase().replace(' ', '-')
---
<Base page="dojo" locale={locale} title={c.seo.title} description={c.seo.description} skipLink={chrome.skipLink} nav={siteNav(locale)} menuLabel={chrome.menuLabel} caption={chrome.caption}>
<section class="section-pad bg-[#f6f1e8]"><div class="site-shell grid gap-12 md:grid-cols-2 md:items-center md:gap-20"><div><p class="section-kicker">{c.eyebrow}</p><h1 class="section-title mt-4 text-5xl md:text-7xl">{c.title}</h1><p class="mt-6 text-xl leading-9 text-[#625c55]">{c.lead}</p></div><img src={c.heroPhoto} alt={c.heroPhotoAlt} class="aspect-[4/3] w-full object-cover object-top" /></div></section>
<section class="section-pad bg-white"><div class="site-shell grid gap-10 md:grid-cols-[.7fr_1.3fr] md:gap-20"><h2 class="section-title">{c.spaceTitle}</h2><div>{c.spaceParagraphs.map(p=><p class="mt-5 text-lg leading-8 text-[#4c4741] first:mt-0">{p}</p>)}</div></div></section>
<section class="bg-[#27231f] text-white" aria-labelledby="teaching-team-title">
  <div id={leadTeacher.id} class="site-shell grid gap-10 py-20 md:grid-cols-[.8fr_1fr] md:items-center md:gap-20 md:py-28">
    <figure class="relative m-0">
      <div class="absolute -bottom-3 -left-3 h-full w-full border border-acento/45" aria-hidden="true"></div>
      <img src={leadTeacher.photo} alt={leadTeacher.photoAlt} class="relative aspect-[4/5] max-h-[42rem] w-full object-cover object-top" />
    </figure>
    <div class="md:py-8">
      <p class="section-kicker text-acento-claro">{leadTeacher.label}</p>
      <h2 id="teaching-team-title" class="mt-4 font-serif text-5xl leading-[1.02] sm:text-6xl md:text-7xl">{leadTeacher.name}</h2>
      <p class="mt-5 text-sm font-bold uppercase tracking-[.14em] text-acento-claro">{leadTeacher.credentials}</p>
      <div class="mt-8 border-l border-white/25 pl-6">
        {leadTeacher.paragraphs.map(p=><p class="mt-5 max-w-2xl text-lg leading-8 text-white/75 first:mt-0">{p}</p>)}
      </div>
      <a class="button mt-9 bg-white text-acento-oscuro" href={leadTeacher.href}>{c.teacher.linkLabel}</a>
    </div>
  </div>

  {/* Sin fichas la franja no se pinta: mejor que una rejilla vacia (ADR-0034). */}
  {c.teachers.length > 0 && (
  <div class="border-t border-white/15 bg-[#211e1b]">
    <div class="site-shell py-16 md:py-20">
      <div class="grid gap-10 md:grid-cols-3 md:gap-0">
        {c.teachers.map((teacher) => (
          <article id={anclaDe(teacher.name)} class="border-b border-white/15 pb-10 md:border-b-0 md:border-r md:px-8 md:pb-0 md:first:pl-0 md:last:border-r-0 md:last:pr-0">
            <img src={teacher.photo} alt={teacher.photoAlt} class="aspect-[4/3] w-full object-cover object-top" loading="lazy" />
            <h3 class="mt-7 font-serif text-3xl leading-tight">{teacher.name}</h3>
            <p class="mt-3 text-xs font-bold uppercase tracking-[.12em] text-acento-claro">{teacher.credentials}</p>
            {teacher.paragraphs.map((p, i) => <p class={i === 0 ? 'mt-6 leading-7 text-white/65' : 'mt-4 leading-7 text-white/65'}>{p}</p>)}
          </article>
        ))}
      </div>
    </div>
  </div>
  )}
</section>
<section class="section-pad bg-[#f6f1e8]"><div class="site-shell"><h2 class="section-title">{c.lineageTitle}</h2><div class="mt-10 grid gap-6 md:grid-cols-3">{c.lineage.map(item=><article class="border border-[#d7cec0] bg-white p-7"><h3 class="font-serif text-2xl">{item.name}</h3><p class="mt-2 text-xs font-bold uppercase tracking-[.12em] text-acento">{item.role}</p><p class="mt-5 leading-7 text-[#625c55]">{item.text}</p></article>)}</div></div></section></Base>
