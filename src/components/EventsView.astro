---
import Base from '../layouts/Base.astro'
import { getContent } from '../lib/content'
import { siteNav, type Locale } from '../lib/i18n'

interface Props { locale: Locale }
const { locale } = Astro.props
const c = getContent('events', locale)
/**
 * La foto de portada y los cinco textos del borde estaban escritos aca adentro
 * (spec 0039): no habia nada que editar aunque hubiera editor. Ahora salen del contenido.
 */
const chrome = c.chrome

/** `01`, `02`… y `10` con dos digitos, no `010`. */
const numero = (index: number) => String(index + 1).padStart(2, '0')
---

<Base page="events" locale={locale} title={c.seo.title} description={c.seo.description} skipLink={chrome.skipLink} nav={siteNav(locale)} menuLabel={chrome.menuLabel} caption={chrome.caption}>
  <section class="relative isolate flex min-h-[31rem] items-end overflow-hidden bg-[#292522] text-center text-white md:min-h-[36rem]">
    <img src={c.heroPhoto} alt="" class="absolute inset-0 -z-20 h-full w-full object-cover" fetchpriority="high" />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/65"></div>
    <div class="site-shell py-16 md:py-20"><p class="section-kicker text-acento-claro">{c.eyebrow}</p><h1 class="mx-auto mt-4 max-w-4xl font-serif text-5xl leading-[1.04] md:text-7xl">{c.title}</h1><p class="mx-auto mt-6 max-w-2xl text-xl leading-9 text-white/75">{c.lead}</p></div>
  </section>

  <section class="bg-[#f6f1e8]">
    {/* Una agenda se vacia sola: sin eventos no se pinta una franja vacia, se dice (ADR-0035). */}
    {c.items.length === 0 ? (
      <div class="site-shell py-20 text-center md:py-28">
        <p class="mx-auto max-w-2xl text-xl leading-9 text-[#625c55]">{c.emptyText}</p>
      </div>
    ) : (
    <div class="site-shell divide-y divide-[#d7cec0]">
      {c.items.map((event, index) => (
        <article class="grid gap-8 py-12 md:grid-cols-2 md:gap-20 md:py-20">
          <img src={event.photo} alt={event.photoAlt} class:list={['aspect-[4/5] w-full object-cover', index % 2 === 1 && 'md:order-2']} style={event.photoFoco ? `object-position:${event.photoFoco}` : undefined} loading="lazy" />
          <div class="self-center"><p class="section-kicker">{numero(index)} · {event.location}</p><h2 class="mt-4 font-serif text-4xl leading-tight md:text-5xl">{event.title}</h2><p class="mt-5 font-oxanium text-sm font-medium tracking-[.05em] text-acento">{event.date}</p><p class="mt-6 text-lg leading-8 text-[#4c4741]">{event.description}</p></div>
        </article>
      ))}
    </div>
    )}
  </section>
</Base>
