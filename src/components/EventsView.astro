---
import Base from '../layouts/Base.astro'
import { getContent } from '../lib/content'
import { siteNav, type Locale } from '../lib/i18n'

interface Props { locale: Locale }
const { locale } = Astro.props
const c = getContent('events', locale)
const HERO_PHOTO =
  'https://static.wixstatic.com/media/ae7240_de66207c487b4e8086d18ed67c88ea93~mv2.jpg/v1/crop/x_218,y_0,w_1165,h_900/fill/w_1600,h_1067,al_c,q_85/IMG_3502_JPG.jpg'
const ui = {
  pt: { caption: 'Aikido · Lisboa', menu: 'Menu', skip: 'Saltar para o conteúdo', org: 'Associação sem fins lucrativos' },
  es: { caption: 'Aikido · Lisboa', menu: 'Menú', skip: 'Saltar al contenido', org: 'Asociación sin fines de lucro' },
  fr: { caption: 'Aïkido · Lisbonne', menu: 'Menu', skip: 'Aller au contenu', org: 'Association à but non lucratif' },
  en: { caption: 'Aikido · Lisbon', menu: 'Menu', skip: 'Skip to content', org: 'Non-profit association' },
}[locale]
---

<Base page="events" locale={locale} title={c.seo.title} description={c.seo.description} skipLink={ui.skip} nav={siteNav(locale)} menuLabel={ui.menu} caption={ui.caption}>
  <section class="relative isolate flex min-h-[31rem] items-end overflow-hidden bg-[#292522] text-center text-white md:min-h-[36rem]">
    <img src={HERO_PHOTO} alt="" class="absolute inset-0 -z-20 h-full w-full object-cover" fetchpriority="high" />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/65"></div>
    <div class="site-shell py-16 md:py-20"><p class="section-kicker text-[#b3e5ff]">{c.eyebrow}</p><h1 class="mx-auto mt-4 max-w-4xl font-serif text-5xl leading-[1.04] md:text-7xl">{c.title}</h1><p class="mx-auto mt-6 max-w-2xl text-xl leading-9 text-white/75">{c.lead}</p></div>
  </section>

  <section class="bg-[#f6f1e8]">
    <div class="site-shell divide-y divide-[#d7cec0]">
      {c.items.map((event, index) => (
        <article class="grid gap-8 py-12 md:grid-cols-2 md:gap-20 md:py-20">
          <img src={event.photo} alt={event.photoAlt} class:list={['aspect-[4/3] w-full object-cover', index % 2 === 1 && 'md:order-2']} loading="lazy" />
          <div class="self-center"><p class="section-kicker">0{index + 1} · {event.location}</p><h2 class="mt-4 font-serif text-4xl leading-tight md:text-5xl">{event.title}</h2><p class="mt-5 font-oxanium text-sm font-medium tracking-[.05em] text-[#0099ff]">{event.date}</p><p class="mt-6 text-lg leading-8 text-[#4c4741]">{event.description}</p></div>
        </article>
      ))}
    </div>
  </section>
  <p slot="footer-note" class="text-sm text-white/65">Benfica · Lumiar · Encarnação<br />{ui.org}</p>
</Base>
